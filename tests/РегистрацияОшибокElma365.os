КонецПроцедуры

Процедура ТестДолжен_НеДублироватьПользователяЕслиОнПервыйВМассиве() Экспорт

	// Регрессия: Массив.Найти возвращает индекс 0 для первого элемента.
	// Проверка «<> Неопределено» не должна ошибочно считать 0 отсутствием совпадения.
	Провайдер = Новый ПровайдерИнтеграцииElma365;
	ИдПользователя = "88f7d3ec-8dc2-4096-b29e-d61abf7dc1bc";

	ТекущийСписок = Новый Массив;
	ТекущийСписок.Добавить(ИдПользователя);
	ТекущийСписок.Добавить("019dbe0c-e621-74aa-b637-945023c7a137");

	Результат = Провайдер.ДополнитьМассив(ТекущийСписок, ИдПользователя);

	Ожидаем.Что(Результат).Равно(Неопределено);
	Ожидаем.Что(ТекущийСписок.Найти(ИдПользователя)).Равно(0);

КонецПроцедуры

Процедура ТестДолжен_НеДублироватьПользователяИзJsonОтветаList() Экспорт

	Провайдер = Новый ПровайдерИнтеграцииElma365;
	ИдПользователя = "5eb95afb-1858-4a72-ac4e-f34a48b3646b";

	Элемент = ЭлементПриложенияElmaИзJson(
		"{""__id"": ""item-1"", ""affected_users"": [""" + ИдПользователя + """]}");

	Результат = Провайдер.ДополнитьМассив(Элемент["affected_users"], ИдПользователя);

	Ожидаем.Что(Результат).Равно(Неопределено);
	Ожидаем.Что(ТипЗнч(Элемент["affected_users"])).Равно(Тип("Массив"));
	Ожидаем.Что(ТипЗнч(Элемент["affected_users"][0])).Равно(Тип("Строка"));

КонецПроцедуры

Процедура ТестДолжен_НеНаращиватьДублиПриОбновленииПослеJsonList() Экспорт

	// Регрессия: list Elma -> нормализация UUID в строки -> update без дублей.
	Провайдер = Новый ПровайдерИнтеграцииElma365;
	ИдПользователя = "88f7d3ec-8dc2-4096-b29e-d61abf7dc1bc";

	СостояниеПоля = Неопределено;

	Для Сч = 1 По 4 Цикл
		Если Сч = 1 Тогда
			ТекущееПоле = Неопределено;
		Иначе
			Элемент = ЭлементПриложенияElmaИзJson(
				"{""__id"": ""item-1"", ""affected_users"": [""" + ИдПользователя + """]}");
			ТекущееПоле = Элемент["affected_users"];
		КонецЕсли;

		Результат = Провайдер.ДополнитьМассив(ТекущееПоле, ИдПользователя);
		Если Результат <> Неопределено Тогда
			СостояниеПоля = Результат;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СостояниеПоля.Количество()).Равно(1);
	Ожидаем.Что(СостояниеПоля[0]).Равно(ИдПользователя);

КонецПроцедуры

Процедура ТестДолжен_НеНаращиватьДублиПриПовторныхОбновлениях() Экспорт

	// Симуляция цепочки update: list -> ДополнитьМассив -> replace в Elma -> новый list.
	Провайдер = Новый ПровайдерИнтеграцииElma365;
	ИдПользователя = "88f7d3ec-8dc2-4096-b29e-d61abf7dc1bc";

	СостояниеПоля = Неопределено;

	Для Сч = 1 По 4 Цикл
		Результат = Провайдер.ДополнитьМассив(СостояниеПоля, ИдПользователя);
		Если Результат <> Неопределено Тогда
			СостояниеПоля = Результат;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(ТипЗнч(СостояниеПоля)).Равно(Тип("Массив"));
	Ожидаем.Что(СостояниеПоля.Количество()).Равно(1);
	Ожидаем.Что(СостояниеПоля[0]).Равно(ИдПользователя);

КонецПроцедуры

Процедура ТестДолжен_ДобавитьНовогоПользователяКСуществующему() Экспорт

	Провайдер = Новый ПровайдерИнтеграцииElma365;
