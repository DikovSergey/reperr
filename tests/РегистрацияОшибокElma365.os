#Использовать "../src/model"
#Использовать 1connector

// BSLLS:UnusedParameters-off
Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт
// BSLLS:UnusedParameters-on
	
	ВсеТесты = Новый Массив;
	
	ВсеТесты.Добавить("ТестДолжен_ЗарегистрироватьОшибку");
	ВсеТесты.Добавить("ТестДолжен_НайтиЭлементПоИдентификаторуВElma365");
	ВсеТесты.Добавить("ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365");
	ВсеТесты.Добавить("ТестДолжен_НайтиПользователяПоЭлПочте");
	
	Возврат ВсеТесты;
	
КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	
	УстановитьТекущийКаталог(ТекущийСценарий().Каталог);
	КаталогДанных = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "features", "fixtures");
	УстановитьТекущийКаталог(КаталогДанных);
	
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	
КонецПроцедуры

Процедура ТестДолжен_ЗарегистрироватьОшибку() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_ЗарегистрироватьОшибку: в appsettings.json нет elma365 или ""enabled"": false");
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("2466255a-226f-47d2-aa3e-3b7752a1cf62");
	
	ИдСозданногоЭлемента = Провайдер.ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке);

	Ожидаем.Что(ИдСозданногоЭлемента).Заполнено();
	
КонецПроцедуры

Процедура ТестДолжен_НайтиЭлементПоИдентификаторуВElma365() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_НайтиЭлементПоИдентификаторуВElma365: в appsettings.json нет elma365 или ""enabled"": false");
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("2466255a-226f-47d2-aa3e-3b7752a1cf62");
	
	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];
	
	ЭлементСуществующейОшибки = Провайдер.НайтиЭлементПоИдентификатору(ОтпечатокОшибки);
	
	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		Ожидаем.Что(ТипЗнч(ЭлементСуществующейОшибки)).Равно(Тип("Соответствие"));
		Ожидаем.Что(ЭлементСуществующейОшибки["__id"]).Заполнено();
	КонецЕсли;
	
КонецПроцедуры

Процедура ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365: в appsettings.json нет elma365 или ""enabled"": false");
		Возврат;
	КонецЕсли;
	
	ФайловоеХранилище = Новый ФайловоеХранилище("data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("2466255a-226f-47d2-aa3e-3b7752a1cf62");
	
	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];
	
	ЗапросИнфоОбОшибке = Новый Соответствие;
	ЗапросИнфоОбОшибке.Вставить("x_fingerprint", ОтпечатокОшибки);
	
	СообщениеОСуществующей = Провайдер.ПолучитьСообщениеОСуществующейОшибке(ЗапросИнфоОбОшибке, Неопределено);
	ЭлементСуществующейОшибки = Провайдер.НайтиЭлементПоИдентификатору(ОтпечатокОшибки);
	
	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		Ожидаем.Что(СообщениеОСуществующей).Заполнено();
		Ожидаем.Что(СтрНайти(СообщениеОСуществующей, "Elma") > 0).Равно(Истина);
	Иначе
		Ожидаем.Что(СообщениеОСуществующей).Равно(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

// Интеграция: пользователь с таким email должен существовать в Elma (позитивный сценарий).
Процедура ТестДолжен_НайтиПользователяПоЭлПочте() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_НайтиПользователяПоЭлПочте: в appsettings.json нет elma365 или ""enabled"": false");
		Возврат;
	КонецЕсли;
	
	ТестовыйEmail = "sergey.dikov@tcn-nn.ru";
	
	ИдПользователя = Провайдер.НайтиИдПользователяElmaПоEmail(ТестовыйEmail);
	Ожидаем.Что(ЗначениеЗаполнено(ИдПользователя)).Равно(Истина);
	Ожидаем.Что(СтрДлина(ИдПользователя)).Больше(10);
	
КонецПроцедуры

Функция ПрочитатьНастройкиИзФайла()
	
	ПутьКФайлуНастроек = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "appsettings.json");
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлуНастроек, "utf-8");
	СодержимоеФайлаНастроек = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	ПарсерJSON = Новый ПарсерJSON();
	Настройки = ПарсерJSON.ПрочитатьJSON(СодержимоеФайлаНастроек);
	НастройкиElma = Настройки["reperrSettings"]["Integrations"]["elma365"];
	
	Возврат НастройкиElma;
	
КонецФункции

Функция ПолучитьПровайдерElma365()
	
	НастройкиElma = ПрочитатьНастройкиИзФайла();
	
	Если НастройкиElma = Неопределено ИЛИ НастройкиElma["enabled"] <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый ПровайдерИнтеграцииElma365(НастройкиElma);
	
КонецФункции
