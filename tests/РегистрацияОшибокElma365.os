#Использовать "../src/model"

// BSLLS:UnusedParameters-off
Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт
// BSLLS:UnusedParameters-on
	
	ВсеТесты = Новый Массив;
	
	ВсеТесты.Добавить("ТестДолжен_ЗарегистрироватьОшибкуВElma365");
	ВсеТесты.Добавить("ТестДолжен_НайтиЭлементПоИдентификаторуВElma365");
	ВсеТесты.Добавить("ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365");

	Возврат ВсеТесты;
	
КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	
	УстановитьТекущийКаталог(ТекущийСценарий().Каталог);
	
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	
КонецПроцедуры

Функция ПолучитьПровайдерElma365()
	
	ЧтениеТекста = Новый ЧтениеТекста("../src/appsettings.json", "utf-8");
	СодержимоеФайлаНастроек = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	ПарсерJSON = Новый ПарсерJSON();
	Настройки = ПарсерJSON.ПрочитатьJSON(СодержимоеФайлаНастроек);
	НастройкиElma = Настройки["reperrSettings"]["Integrations"]["elma365"];
	
	Если НастройкиElma = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Провайдер = Новый ПровайдерИнтеграцииElma365()
		.URL(НастройкиElma["url"])
		.Токен(НастройкиElma["token"])
		.Раздел(НастройкиElma["namespace"])
		.Приложение(НастройкиElma["app"])
		.ПолеИдентификатора(НастройкиElma["identifierField"])
		.ПолеИмениПользователя(НастройкиElma["userNameField"])
		.СоответствиеПолей(НастройкиElma["fieldMapping"])
		.ПоддерживаетПолучениеПредставленияОшибки(НастройкиElma["supportGetExistingError"] = Истина);
		
	Возврат Провайдер;
	
КонецФункции

Процедура ТестДолжен_ЗарегистрироватьОшибкуВElma365() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_ЗарегистрироватьОшибкуВElma365: не найдена или выключена интеграция с Elma365 в appsettings.json");
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("../data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("2466255a-226f-47d2-aa3e-3b7752a1cf62");
	
	ИдСозданногоЭлемента = Провайдер.ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке);
	
	Ожидаем.Что(ИдСозданногоЭлемента).Заполнено();
	
КонецПроцедуры

Процедура ТестДолжен_НайтиЭлементПоИдентификаторуВElma365() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_НайтиЭлементПоИдентификаторуВElma365: не найдена или выключена интеграция с Elma365 в appsettings.json");
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("../data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("2466255a-226f-47d2-aa3e-3b7752a1cf62");
	
	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];
	
	ЭлементСуществующейОшибки = Провайдер.НайтиЭлементПоИдентификатору(ОтпечатокОшибки);
	
	// Если мы уже запускали тест регистрации, то ошибка должна быть найдена
	// Если нет - то вернется Неопределено. В любом случае метод не должен падать с ошибкой.
	// Можно проверить, что результат либо Неопределено, либо заполненная структура
	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		Ожидаем.Что(ТипЗнч(ЭлементСуществующейОшибки)).Равно(Тип("Соответствие"));
		Ожидаем.Что(ЭлементСуществующейОшибки["__id"]).Заполнено();
	КонецЕсли;
	
КонецПроцедуры

Процедура ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365() Экспорт
	
	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить("Пропущен тест ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365: не найдена или выключена интеграция с Elma365 в appsettings.json");
		Возврат;
	КонецЕсли;
	
	ФайловоеХранилище = Новый ФайловоеХранилище("../data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("2466255a-226f-47d2-aa3e-3b7752a1cf62");
	
	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];
	
	СообщениеОСуществующей = Провайдер.ПолучитьСообщениеОСуществующейОшибке(ОтпечатокОшибки);
	ЭлементСуществующейОшибки = Провайдер.НайтиЭлементПоИдентификатору(ОтпечатокОшибки);
	
	// Если ошибка уже есть в Elma, метод должен вернуть текст с именем элемента; иначе - Неопределено
	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		Ожидаем.Что(СообщениеОСуществующей).Заполнено();
		Ожидаем.Что(СтрНайти(СообщениеОСуществующей, "Elma") > 0).Равно(Истина);
	Иначе
		Ожидаем.Что(СообщениеОСуществующей).Равно(Неопределено);
	КонецЕсли;
	
КонецПроцедуры
