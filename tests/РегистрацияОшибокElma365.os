#Использовать "../src/model"

// BSLLS:UnusedParameters-off
Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт
// BSLLS:UnusedParameters-on

	ВсеТесты = Новый Массив;

	// Без HTTP: разбор ответа Elma и флаги провайдера
	ВсеТесты.Добавить("ТестДолжен_ВыделитьИдПользователяПоТочномуEmailИзОтветаElma");
	ВсеТесты.Добавить("ТестДолжен_ВернутьНеопределеноЕслиВСпискеНетСовпаденияПоEmail");
	ВсеТесты.Добавить("ТестДолжен_ВернутьНеопределеноЕслиОтветПользователейПустой");
	ВсеТесты.Добавить("ТестДолжен_УчестьФлагПолученияПредставленияОшибкиИзНастроек");
	ВсеТесты.Добавить("ТестДолжен_ОтправлятьКаждыйОтчетВсегдаИстина");

	// Интеграция с живым Elma (только при enabled и корректном appsettings)
	ВсеТесты.Добавить("ТестДолжен_ЗарегистрироватьОшибку");
	ВсеТесты.Добавить("ТестДолжен_НайтиЭлементПоИдентификаторуВElma365");
	ВсеТесты.Добавить("ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365");
	ВсеТесты.Добавить("ТестДолжен_НайтиПользователяПоЭлПочте");

	Возврат ВсеТесты;

КонецФункции

Процедура ПередЗапускомТеста() Экспорт

	УстановитьТекущийКаталог(ТекущийСценарий().Каталог);
	КаталогДанных = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "features", "fixtures");
	УстановитьТекущийКаталог(КаталогДанных);

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

КонецПроцедуры

#Область ЮнитТестыБезHTTP

Процедура ТестДолжен_ВыделитьИдПользователяПоТочномуEmailИзОтветаElma() Экспорт

	Провайдер = Новый ПровайдерИнтеграцииElma365;
	Элементы = Новый Массив;
	Элементы.Добавить(ЭлементПользователяElma("id-wrong", "other@mail.ru"));
	Элементы.Добавить(ЭлементПользователяElma("id-need", "User@Example.COM"));
	Ответ = ОтветСпискаПользователейElma(Элементы);

	Ид = Провайдер.ИдПользователяЭлмаИзОтветаСпискаПользователей(Ответ, "user@example.com");
	Ожидаем.Что(Ид).Равно("id-need");

КонецПроцедуры

Процедура ТестДолжен_ВернутьНеопределеноЕслиВСпискеНетСовпаденияПоEmail() Экспорт

	Провайдер = Новый ПровайдерИнтеграцииElma365;
	Элементы = Новый Массив;
	Элементы.Добавить(ЭлементПользователяElma("first-id", "a@a.ru"));
	Элементы.Добавить(ЭлементПользователяElma("second-id", "b@b.ru"));
	Ответ = ОтветСпискаПользователейElma(Элементы);

	Ид = Провайдер.ИдПользователяЭлмаИзОтветаСпискаПользователей(Ответ, "missing@nowhere.ru");
	Ожидаем.Что(Ид).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолжен_ВернутьНеопределеноЕслиОтветПользователейПустой() Экспорт

	Провайдер = Новый ПровайдерИнтеграцииElma365;
	Ожидаем.Что(Провайдер.ИдПользователяЭлмаИзОтветаСпискаПользователей(Неопределено, "a@b.ru")).Равно(Неопределено);

	ПустойОтвет = Новый Соответствие;
	ПустойОтвет.Вставить("result", Новый Соответствие);
	ПустойОтвет["result"].Вставить("result", Новый Массив);
	Ожидаем.Что(Провайдер.ИдПользователяЭлмаИзОтветаСпискаПользователей(ПустойОтвет, "a@b.ru")).Равно(Неопределено);

КонецПроцедуры

Процедура ТестДолжен_УчестьФлагПолученияПредставленияОшибкиИзНастроек() Экспорт

	П = Новый ПровайдерИнтеграцииElma365;
	Ожидаем.Что(П.ДоступноПолучениеПредставленияОшибки()).Равно(Ложь);

	Параметры = МинимальныеПараметрыПровайдераElma365();
	Параметры.Вставить("support-get-existing-error", Истина);
	ПСВключен = Новый ПровайдерИнтеграцииElma365(Параметры);
	Ожидаем.Что(ПСВключен.ДоступноПолучениеПредставленияОшибки()).Равно(Истина);

КонецПроцедуры

Процедура ТестДолжен_ОтправлятьКаждыйОтчетВсегдаИстина() Экспорт

	П = Новый ПровайдерИнтеграцииElma365;
	Ожидаем.Что(П.ОтправлятьКаждыйОтчет()).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область ИнтеграционныеТесты

Процедура ТестДолжен_ЗарегистрироватьОшибку() Экспорт

	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить(ТекстПропускаИнтеграцииElma365("ТестДолжен_ЗарегистрироватьОшибку"));
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке(ИдОтчетаДляИнтеграцииElma365());

	ИдСозданногоЭлемента = Провайдер.ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке);

	Ожидаем.Что(ИдСозданногоЭлемента).Заполнено();

КонецПроцедуры

Процедура ТестДолжен_НайтиЭлементПоИдентификаторуВElma365() Экспорт

	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить(ТекстПропускаИнтеграцииElma365("ТестДолжен_НайтиЭлементПоИдентификаторуВElma365"));
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке(ИдОтчетаДляИнтеграцииElma365());

	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];

	ЭлементСуществующейОшибки = Провайдер.НайтиЭлементПоИдентификатору(ОтпечатокОшибки);

	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		Ожидаем.Что(ТипЗнч(ЭлементСуществующейОшибки)).Равно(Тип("Соответствие"));
		Ожидаем.Что(ЭлементСуществующейОшибки["__id"]).Заполнено();
	КонецЕсли;

КонецПроцедуры

Процедура ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365() Экспорт

	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить(ТекстПропускаИнтеграцииElma365("ТестДолжен_ПолучитьСообщениеОСуществующейОшибкеВElma365"));
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке(ИдОтчетаДляИнтеграцииElma365());

	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];

	ЗапросИнфоОбОшибке = Новый Соответствие;
	ЗапросИнфоОбОшибке.Вставить("x_fingerprint", ОтпечатокОшибки);

	СообщениеОСуществующей = Провайдер.ПолучитьСообщениеОСуществующейОшибке(ЗапросИнфоОбОшибке);
	ЭлементСуществующейОшибки = Провайдер.НайтиЭлементПоИдентификатору(ОтпечатокОшибки);

	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		Ожидаем.Что(СообщениеОСуществующей).Заполнено();
		Ожидаем.Что(СтрНайти(СообщениеОСуществующей, "Данная ошибка уже зарегистрирована в Elma:") > 0).Равно(Истина);
	Иначе
		Ожидаем.Что(СообщениеОСуществующей).Равно(Неопределено);
	КонецЕсли;

КонецПроцедуры

// Интеграция: в appsettings в узле elma365 можно задать "test-user-email": "user@domain.ru".
// Без этого ключ тест пропускается (удобно для CI и чужих стендов).
Процедура ТестДолжен_НайтиПользователяПоЭлПочте() Экспорт

	Провайдер = ПолучитьПровайдерElma365();
	Если Провайдер = Неопределено Тогда
		Сообщить(ТекстПропускаИнтеграцииElma365("ТестДолжен_НайтиПользователяПоЭлПочте"));
		Возврат;
	КонецЕсли;

	НастройкиElma = ПрочитатьНастройкиElma365ИзФайла();
	ТестовыйEmail = Неопределено;
	Если НастройкиElma <> Неопределено Тогда
		ТестовыйEmail = НастройкиElma["test-user-email"];
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТестовыйEmail) Тогда
		Сообщить("Пропущен ТестДолжен_НайтиПользователяПоЭлПочте: задайте в reperrSettings.Integrations.elma365 ключ ""test-user-email"" (email существующего пользователя Elma)");
		Возврат;
	КонецЕсли;

	ИдПользователя = Провайдер.НайтиИдПользователяПоПочте(ТестовыйEmail);
	Ожидаем.Что(ЗначениеЗаполнено(ИдПользователя)).Равно(Истина);
	Ожидаем.Что(СтрДлина(ИдПользователя)).Больше(10);

КонецПроцедуры

#КонецОбласти

Функция ТекстПропускаИнтеграцииElma365(ИмяТеста)

	Возврат СтрШаблон(
		"Пропущен %1: нет файла src/appsettings.json, в нём нет reperrSettings.Integrations.elma365 или ""enabled"": false",
		ИмяТеста);

КонецФункции

Функция ЭлементПользователяElma(Ид, Email)

	Эл = Новый Соответствие;
	Эл.Вставить("__id", Ид);
	Эл.Вставить("email", Email);
	Возврат Эл;

КонецФункции

Функция ОтветСпискаПользователейElma(МассивПользователей)

	Внутри = Новый Соответствие;
	Внутри.Вставить("result", МассивПользователей);
	Ответ = Новый Соответствие;
	Ответ.Вставить("result", Внутри);
	Возврат Ответ;

КонецФункции

Функция МинимальныеПараметрыПровайдераElma365()

	Параметры = Новый Соответствие;
	Параметры.Вставить("url", "https://example.invalid");
	Параметры.Вставить("token", "t");
	Параметры.Вставить("namespace", "ns");
	Параметры.Вставить("app", "app");
	Параметры.Вставить("identifier-field", "error_hash");
	Параметры.Вставить("user-name-field", "error_user_name");
	Параметры.Вставить("field-mapping", Новый Соответствие);
	Возврат Параметры;

КонецФункции

Функция ПрочитатьНастройкиElma365ИзФайла()

	ПутьКФайлуНастроек = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "appsettings.json");
	ФайлНастроек = Новый Файл(ПутьКФайлуНастроек);
	Если НЕ ФайлНастроек.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлуНастроек, "utf-8");
	СодержимоеФайлаНастроек = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	ПарсерJSON = Новый ПарсерJSON();
	Настройки = ПарсерJSON.ПрочитатьJSON(СодержимоеФайлаНастроек);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	УзелReperr = Настройки["reperrSettings"];
	Если УзелReperr = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Интеграции = УзелReperr["Integrations"];
	Если Интеграции = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Интеграции["elma365"];

КонецФункции

Функция ПолучитьПровайдерElma365()

	НастройкиElma = ПрочитатьНастройкиElma365ИзФайла();

	Если НастройкиElma = Неопределено ИЛИ НастройкиElma["enabled"] <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый ПровайдерИнтеграцииElma365(НастройкиElma);

КонецФункции

// Каталог с report.json в features/fixtures/data (тот же UUID, что в тестах Jira/Redmine).
Функция ИдОтчетаДляИнтеграцииElma365()
	Возврат "61001a5e-09d5-47b8-bf19-e7672eda10e5";
КонецФункции
