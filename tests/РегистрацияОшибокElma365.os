	Результат = Провайдер.ДополнитьМассив(ТекущийСписок, ИдВторого);

	Ожидаем.Что(Результат).Заполнено();
	Ожидаем.Что(Результат.Количество()).Равно(2);
	Ожидаем.Что(Результат[0]).Равно(ИдПервого);
	Ожидаем.Что(Результат[1]).Равно(ИдВторого);

КонецПроцедуры

