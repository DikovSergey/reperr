#Использовать "../src/model"

// BSLLS:UnusedParameters-off
Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт
// BSLLS:UnusedParameters-on
	
	ВсеТесты = Новый Массив;
	
	ВсеТесты.Добавить("ТестДолжен_СформироватьТелоЗапросаRedmine");
	ВсеТесты.Добавить("ТестДолжен_ЗарегистрироватьОшибку");

	Возврат ВсеТесты;
	
КонецФункции

Процедура ПередЗапускомТеста() Экспорт
	
	УстановитьТекущийКаталог(ТекущийСценарий().Каталог);
	
КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт
	
КонецПроцедуры

Процедура ТестДолжен_СформироватьТелоЗапросаRedmine() Экспорт
	
	ПровайдерИнтеграцииRedmine = Новый ПровайдерИнтеграцииRedmine()
												.URLRedmine("url")
												.КлючAPI("APIKey")
												.ИдПроекта("project-id")
												.ИдТрекера("1")
												.ИдПриоритета("1")
												.ИдСтатуса("1")
												.Тема("topic")
												.КоличествоЧасов("1");

	ФайловоеХранилище = Новый ФайловоеХранилище("../features/fixtures/data");

	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("61001a5e-09d5-47b8-bf19-e7672eda10e5");
	
	// В тестах не выполняем реальные запросы за токенами файлов к Redmine API
	ПрикрепляемыеФайлы = Новый Массив();
	Результат = ПровайдерИнтеграцииRedmine.СформироватьТелоЗапроса(ДанныеОтчетаОбОшибке, ПрикрепляемыеФайлы);
	
	ЧтениеТекста = Новый ЧтениеТекста("../features/fixtures/requestBodyRedmine.json", "utf-8");
	Эталон = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	Ожидаем.Что(Результат).Равно(Эталон);
	
КонецПроцедуры

Процедура ТестДолжен_ЗарегистрироватьОшибку() Экспорт

	Провайдер = ПолучитьПровайдерRedmine();
	Если Провайдер = Неопределено Тогда
		Сообщить(ТекстПропускаИнтеграцииRedmine("ТестДолжен_ЗарегистрироватьОшибку"));
		Возврат;
	КонецЕсли;

	ФайловоеХранилище = Новый ФайловоеХранилище("../features/fixtures/data");
	ДанныеОтчетаОбОшибке = ФайловоеХранилище.ПолучитьДанныеОтчетаОбОшибке("61001a5e-09d5-47b8-bf19-e7672eda10e5");

	ИдЗадачиВТрекере = Провайдер.ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке);

	Ожидаем.Что(ИдЗадачиВТрекере).Заполнено();

КонецПроцедуры

Функция ТекстПропускаИнтеграцииRedmine(ИмяТеста)
	Возврат СтрШаблон(
		"Пропущен %1: нет файла src/appsettings.json, в нём нет reperrSettings.Integrations.redmine или ""enabled"": false",
		ИмяТеста);
КонецФункции

Функция ПрочитатьНастройкиRedmineИзФайла()

	ПутьКФайлуНастроек = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "appsettings.json");
	ФайлНастроек = Новый Файл(ПутьКФайлуНастроек);
	Если НЕ ФайлНастроек.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлуНастроек, "utf-8");
	СодержимоеФайлаНастроек = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	ПарсерJSON = Новый ПарсерJSON();
	Настройки = ПарсерJSON.ПрочитатьJSON(СодержимоеФайлаНастроек);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	УзелReperr = Настройки["reperrSettings"];
	Если УзелReperr = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Интеграции = УзелReperr["Integrations"];
	Если Интеграции = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Интеграции["redmine"];

КонецФункции

Функция ПолучитьПровайдерRedmine()

	НастройкиRedmine = ПрочитатьНастройкиRedmineИзФайла();

	Если НастройкиRedmine = Неопределено ИЛИ НастройкиRedmine["enabled"] <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый ПровайдерИнтеграцииRedmine(НастройкиRedmine);

КонецФункции

