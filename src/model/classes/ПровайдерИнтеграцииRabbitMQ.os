#Использовать RabbitMQ
#Использовать json

// Имя пользователя
Перем Пользователь;

// Пароль
Перем Пароль;

// Сервер
Перем Сервер;

// Виртуальный хост
Перем ВиртуальныйХост;

// Имя точки обмена
Перем ИмяТочкиОбмена;

// Поддерживает ли провайдер получение представления существующей ошибки
Перем ПоддерживаетПолучениеПредставленияОшибки;

Процедура ПриСозданииОбъекта()
	ПоддерживаетПолучениеПредставленияОшибки = Ложь;
КонецПроцедуры

// Устанавливает признак поддержки получения представления ошибки
//
// Параметры:
//  вхЗначение - Булево, Неопределено - Новое значение признака; при Неопределено значение не изменяется.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииRabbitMQ - текущий объект (цепочка вызовов).
Функция ПоддерживаетПолучениеПредставленияОшибки(вхЗначение = Неопределено) Экспорт
	Если вхЗначение <> Неопределено Тогда
		ПоддерживаетПолучениеПредставленияОшибки = вхЗначение;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает признак поддержки получения представления существующей ошибки
//
// Возвращаемое значение:
//  Булево
Функция ПоддерживаетсяПолучениеПредставленияОшибки() Экспорт
	Возврат ПоддерживаетПолучениеПредставленияОшибки;
КонецФункции

// Возвращает признак отправки каждого отчета независимо от отпечатка ошибки
//
// Возвращаемое значение:
//  Булево
Функция ОтправлятьКаждыйОтчет() Экспорт
	Возврат Истина;
КонецФункции

Функция Пользователь(вхПользователь) Экспорт
	
	Пользователь = вхПользователь;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция Пароль(вхПароль) Экспорт
	
	Пароль = вхПароль;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция Сервер(вхСервер) Экспорт
	
	Сервер = вхСервер;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ВиртуальныйХост(вхВиртуальныйХост) Экспорт
	
	ВиртуальныйХост = вхВиртуальныйХост;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ИмяТочкиОбмена(вхИмяТочкиОбмена) Экспорт
	
	ИмяТочкиОбмена = вхИмяТочкиОбмена;
	
	Возврат ЭтотОбъект;
	
КонецФункции

Функция ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке) Экспорт
	
	Соединение = Новый СоединениеRMQ;
	
	Соединение.Пользователь = Пользователь;
	Соединение.Пароль = Пароль;
	Соединение.Сервер = Сервер;
	Соединение.ВиртуальныйХост = ВиртуальныйХост;
	
	Попытка 
		Клиент = Соединение.Установить();
	Исключение
		ВызватьИсключение("Не удалось установить соединение RabbitMQ");
	КонецПопытки;

	Сообщение = СформироватьТелоЗапроса(ДанныеОтчетаОбОшибке);

	Попытка
		Клиент.ОтправитьСтроку(Сообщение, ИмяТочкиОбмена);
	Исключение
		Соединение.Закрыть();
		ВызватьИсключение("Не удалось отправить сообщение в точку обмена");
	КонецПопытки;

	Соединение.Закрыть();

	// Для провайдера RMQ не существует такого понятия как ИдЗадачиВТрекере
	Возврат Неопределено;
	
КонецФункции

Функция СформироватьТелоЗапроса(ДанныеОтчетаОбОшибке) Экспорт
	
	Описание = ОтчетыОбОшибках.СформироватьТелоОписанияОшибкиJSON(ДанныеОтчетаОбОшибке);
	
	ПарсерJSON = Новый ПарсерJSON();
	Возврат ПарсерJSON.ЗаписатьJSON(Описание);
	
КонецФункции
