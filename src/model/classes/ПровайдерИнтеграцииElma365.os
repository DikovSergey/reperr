#Использовать 1connector

#Область ПараметрыИПеременные

// URL сервера Elma365
Перем URL;

// Токен авторизации (API Key)
Перем Токен;

// Код раздела (namespace)
Перем Раздел;

// Код приложения (code)
Перем Приложение;

// Имя поля в Elma365, которое будет хранить идентификатор (хэш) ошибки для группировки
Перем ПолеИдентификатора;

// Имя поля в Elma365 для хранения списка имён пользователей (отображаемое имя из отчёта)
Перем ПолеИмениПользователя;

// Опционально: поле ссылок на пользователей Elma (__id); если задано, идентификаторы пишутся сюда, а не в ПолеИмениПользователя
Перем ПолеСсылкиНаПользователя;

// Соответствие полей: Ключ - поле в Elma365, Значение - макрос или путь к данным
Перем СоответствиеПолей;

// См. УстановитьПоддержкуПолученияПредставленияОшибки и ДоступноПолучениеПредставленияОшибки
Перем ПоддерживаетПолучениеПредставленияОшибки;

// Опционально: получить email по имени пользователя через внешний REST API (Basic)
// и подставить в Elma идентификатор пользователя, найденного по email.
// Структура: ИдентифицироватьПоEmail, Эндпоинт, Логин, Пароль, МетодHTTP, ИмяПараметраЗапроса
// (источник - вложенный узел настроек интеграции в appsettings: method, url, учётные данные и т.д.).
Перем СервисПрофиляПользователя;

// После создания нового элемента приложения: POST .../pub/v1/bpm/template/{namespace}/{code}/run (см. документацию Elma365 Public API).
Перем ЗапускатьПроцессПослеСозданияЭлемента;
Перем РазделШаблонаПроцесса;
Перем КодШаблонаПроцесса;
// Имя переменной контекста процесса; в неё передаётся ссылка на созданную запись - массив из одного UUID строкой (как в примере API Elma для полей ссылки на приложение).
Перем ИмяПеременнойКонтекстаПроцессаЭлементПриложения;

#КонецОбласти

#Область Инициализация

// Инициализирует провайдер: значения по умолчанию; при передаче Параметры - поля из узла интеграции в appsettings.json.
//
// Параметры:
//  Параметры - Соответствие, Структура, Неопределено - настройки одной интеграции из reperrSettings.Integrations
//      При Неопределено остаются только значения по умолчанию
//
Процедура ПриСозданииОбъекта(Параметры = Неопределено)

	СоответствиеПолей = Новый Соответствие;
	ПолеСсылкиНаПользователя = "";
	ПоддерживаетПолучениеПредставленияОшибки = Ложь;
	СервисПрофиляПользователя = Новый Структура(
		"ИдентифицироватьПоEmail, Эндпоинт, Логин, Пароль, МетодHTTP, ИмяПараметраЗапроса",
		Ложь, "", "", "", "POST", "userName");

	ЗапускатьПроцессПослеСозданияЭлемента = Ложь;
	РазделШаблонаПроцесса = "";
	КодШаблонаПроцесса = "";
	ИмяПеременнойКонтекстаПроцессаЭлементПриложения = "";

	Если Параметры <> Неопределено Тогда
		УстановитьURL(Параметры["url"]);
		УстановитьТокен(Параметры["token"]);
		УстановитьРаздел(Параметры["namespace"]);
		УстановитьПриложение(Параметры["app"]);
		УстановитьПолеИдентификатора(Параметры["identifier-field"]);
		УстановитьПолеИмениПользователя(Параметры["user-name-field"]);
		УстановитьПолеСсылкиНаПользователя(Параметры["user-reference-field"]);
		УстановитьСоответствиеПолей(Параметры["field-mapping"]);
		УстановитьПоддержкуПолученияПредставленияОшибки(Параметры["support-get-existing-error"] = Истина);
		ПрочитатьНастройкиСервисаПрофиляПользователя(Параметры);
		ПрочитатьНастройкиЗапускаПроцессаПослеСозданияЭлемента(Параметры);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает признак доступности получения представления существующей ошибки
// (проверка - ДоступноПолучениеПредставленияОшибки).
//
// Параметры:
//  вхЗначение - Булево, Неопределено - Новое значение признака; при Неопределено значение не изменяется.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьПоддержкуПолученияПредставленияОшибки(вхЗначение = Неопределено) Экспорт
	Если вхЗначение <> Неопределено Тогда
		ПоддерживаетПолучениеПредставленияОшибки = вхЗначение;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Истина, если провайдер умеет вернуть пользовательское представление уже существующей ошибки.
//
// Возвращаемое значение:
//  Булево
Функция ДоступноПолучениеПредставленияОшибки() Экспорт
	Возврат ПоддерживаетПолучениеПредставленияОшибки;
КонецФункции

// Возвращает признак отправки каждого отчета независимо от отпечатка ошибки
//
// Возвращаемое значение:
//  Булево
Функция ОтправлятьКаждыйОтчет() Экспорт
	Возврат Истина;
КонецФункции

// Устанавливает базовый URL Elma365 (завершающий символ "/" отбрасывается).
//
// Параметры:
//  вхURL - Строка - базовый URL сервера.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьURL(вхURL) Экспорт
	Если Прав(вхURL, 1) = "/" Тогда
		URL = Лев(вхURL, СтрДлина(вхURL) - 1);
	Иначе
		URL = вхURL;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает токен авторизации (API Key).
//
// Параметры:
//  вхТокен - Строка - токен доступа к API Elma365.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьТокен(вхТокен) Экспорт
	Токен = вхТокен;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает код раздела (namespace) в Elma365.
//
// Параметры:
//  вхРаздел - Строка - код раздела из настроек интеграции.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьРаздел(вхРаздел) Экспорт
	Раздел = вхРаздел;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает код приложения (code) в Elma365.
//
// Параметры:
//  вхПриложение - Строка - код приложения из настроек интеграции.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьПриложение(вхПриложение) Экспорт
	Приложение = вхПриложение;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает имя поля в элементе приложения Elma365 для идентификатора (хэша) ошибки.
//
// Параметры:
//  вхПолеИдентификатора - Строка - имя поля (см. соответствие полей в настройках интеграции).
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьПолеИдентификатора(вхПолеИдентификатора) Экспорт
	ПолеИдентификатора = вхПолеИдентификатора;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает имя поля в элементе приложения Elma365 для имени пользователя (списка пользователей).
//
// Параметры:
//  вхПолеИмениПользователя - Строка - имя поля (см. соответствие полей в настройках интеграции).
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьПолеИмениПользователя(вхПолеИмениПользователя) Экспорт
	ПолеИмениПользователя = вхПолеИмениПользователя;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает имя поля в элементе приложения Elma365 для ссылок на пользователей (__id).
// В это поле записывается массив идентификаторов пользователей Elma, определенных по email.
//
// Параметры:
//  вхПоле - Строка, Неопределено - имя поля из настроек (user-reference-field); пустое значение отключает заполнение поля.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьПолеСсылкиНаПользователя(вхПоле) Экспорт
	Если ЗначениеЗаполнено(вхПоле) Тогда
		ПолеСсылкиНаПользователя = Строка(вхПоле);
	Иначе
		ПолеСсылкиНаПользователя = "";
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает соответствие полей в элементе приложения Elma365.
//
// Параметры:
//  вхСоответствиеПолей - Соответствие, Структура, Неопределено - соответствие полей из настроек интеграции.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция УстановитьСоответствиеПолей(вхСоответствиеПолей) Экспорт
	Если ТипЗнч(вхСоответствиеПолей) = Тип("Соответствие") Тогда
		СоответствиеПолей = вхСоответствиеПолей;
	ИначеЕсли ТипЗнч(вхСоответствиеПолей) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из вхСоответствиеПолей Цикл
			СоответствиеПолей.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		СоответствиеПолей = Новый Структура;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область РегистрацияОшибкиИПоискДублей

// Регистрирует ошибку в приложении Elma365: при совпадении отпечатка обновляет существующий элемент,
// иначе создаёт новый.
//
// Параметры:
//  ДанныеОтчетаОбОшибке - Произвольный - данные отчёта об ошибке после обработки хранилищем
//      (в т.ч. Отчет, ключ fingerprint).
//
// Возвращаемое значение:
//  Произвольный - идентификатор элемента приложения Elma365 (__id найденной или созданной записи).
Функция ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке) Экспорт
	
	Сообщить("Регистрирую ошибку в Elma365");
	
	Отчет = ДанныеОтчетаОбОшибке.Отчет;
	ДанныеИсключения = ИзвлечьДанныеИсключения(Отчет);
	
	// Формируем уникальный хэш ошибки для группировки
	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];
	Сообщить(СтрШаблон("Отпечаток ошибки в Elma365 (ID: %1)", ОтпечатокОшибки));
	
	// Проверяем, существует ли уже такая ошибка в Elma365
	ЭлементСуществующейОшибки = НайтиЭлементПоИдентификатору(ОтпечатокОшибки);
	
	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		ИдСуществующейОшибки = ЭлементСуществующейОшибки["__id"];
		// TODO: заменить на logger
		ШаблонСообщенияДубль = "Ошибка уже зарегистрирована в Elma365 (ID: %1). Пропускаем создание дубля.";
		Сообщить(СтрШаблон(ШаблонСообщенияДубль, ИдСуществующейОшибки));
		
		ДанныеПользователя = ДанныеПользователяДляКонтекстаElma(Отчет);
		ОбновитьСписокПользователей(
			ИдСуществующейОшибки,
			ЭлементСуществующейОшибки,
			ДанныеПользователя.ИмяПользователя,
			ДанныеПользователя.ИдентификаторПользователя);
		ОбновитьВложения(ИдСуществующейОшибки, ЭлементСуществующейОшибки, ДанныеОтчетаОбОшибке);
		
		Возврат ИдСуществующейОшибки;
	КонецЕсли;
	
	// Создаем новый элемент приложения
	ИдСозданногоЭлемента = СоздатьЭлементПриложения(ДанныеОтчетаОбОшибке, ДанныеИсключения, ОтпечатокОшибки);
	
	Если ЗначениеЗаполнено(ИдСозданногоЭлемента) Тогда
		ЗапуститьШаблонБизнесПроцессаПослеСозданияЭлемента(ИдСозданногоЭлемента);
	КонецЕсли;
	
	Возврат ИдСозданногоЭлемента;
	
КонецФункции

#КонецОбласти

#Область ПредставлениеСуществующейОшибки

// Возвращает пользовательское сообщение о том, что ошибка уже зарегистрирована в Elma365.
//
// Параметры:
//  ЗапросИнфоОбОшибке - Произвольный - контекст запроса (ожидается ключ x_fingerprint для поиска записи).
//
// Возвращаемое значение:
//  Строка, Неопределено - строка с названием записи Elma, если найдена; иначе Неопределено.
Функция ПолучитьСообщениеОСуществующейОшибке(ЗапросИнфоОбОшибке) Экспорт
	
	ПредставлениеОшибки = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ПолеИдентификатора) Тогда
		Возврат ПредставлениеОшибки;
	КонецЕсли;
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/list", URL, Раздел, Приложение);
	
	ФильтрПоле = Новый Соответствие;
	ФильтрПоле.Вставить(ПолеИдентификатора, ЗапросИнфоОбОшибке["x_fingerprint"]);
	
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("tf", ФильтрПоле);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("size", 1);
	ТелоЗапросаJSON.Вставить("active", Истина);
	ТелоЗапросаJSON.Вставить("filter", Фильтр);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		Ответ = ПрочитатьJsonОтветElma365(РезультатЗапроса.Текст());
		РезультатОтвета = Ответ["result"];
		Если РезультатОтвета <> Неопределено Тогда
			Элементы = РезультатОтвета["result"];
			Если Элементы <> Неопределено И Элементы.Количество() > 0 Тогда
				ИмяЭлемента = Элементы[0]["__name"];
				Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
					ПредставлениеОшибки = СтрШаблон("Данная ошибка уже зарегистрирована в Elma: %1", ИмяЭлемента);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Сообщить("Не удалось получить представление ошибки в Elma365. Код ответа: " + РезультатЗапроса.КодСостояния);
		Сообщить("Ответ: " + РезультатЗапроса.Текст());
	КонецЕсли;
	
	Возврат ПредставлениеОшибки;
	
КонецФункции

#КонецОбласти

#Область ЭлементыПриложенияElma365

// Ищет элемент приложения Elma365 по идентификатору (хэшу) ошибки.
//
// Параметры:
//  ИдентификаторОшибки - Строка - идентификатор (хэш) ошибки.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - соответствие с данными элемента, если найден; иначе Неопределено.
Функция НайтиЭлементПоИдентификатору(ИдентификаторОшибки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПолеИдентификатора) Тогда
		Возврат Неопределено; // Если поле не задано, не группируем по отпечатку ошибки
	КонецЕсли;
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/list", URL, Раздел, Приложение);
	
	ФильтрПоле = Новый Соответствие;
	ФильтрПоле.Вставить(ПолеИдентификатора, ИдентификаторОшибки);
	
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("tf", ФильтрПоле);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("active", Истина);
	ТелоЗапросаJSON.Вставить("filter", Фильтр);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	НайденныйЭлемент = Неопределено;
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		Ответ = ПрочитатьJsonОтветElma365(РезультатЗапроса.Текст());
		РезультатОтвета = Ответ["result"];
		Если РезультатОтвета <> Неопределено Тогда
			Элементы = РезультатОтвета["result"];
			Если Элементы <> Неопределено И Элементы.Количество() > 0 Тогда
				НайденныйЭлемент = Элементы[0];
				НормализоватьПоляСсылкиПользователяВЭлементе(НайденныйЭлемент);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НайденныйЭлемент;
	
КонецФункции

#КонецОбласти

#Область ПользователиElmaИОпределениеПоEmail

Функция ДанныеПользователяДляКонтекстаElma(Отчет)
	
	ИмяПользователя = ИмяПользователяИзОтчета(Отчет);
	Идентификатор = ИдентификаторПользователяElmaИзОтчета(Отчет);
	
	Возврат Новый Структура("ИмяПользователя, ИдентификаторПользователя", ИмяПользователя, Идентификатор);
	
КонецФункции

// Возвращает __id пользователя Elma (если удаётся определить его по имени из отчёта через сервис email и поиск в Elma);
// иначе возвращает пустую строку.
//
// Параметры:
//  Отчет - Произвольный - JSON отчёта об ошибке (как в обработчике).
//
// Возвращаемое значение:
//  Строка - __id пользователя Elma или "".
Функция ИдентификаторПользователяElmaИзОтчета(Отчет) Экспорт
	
	ИмяПользователя = ИмяПользователяИзОтчета(Отчет);
	
	Если НЕ СервисПрофиляПользователя.ИдентифицироватьПоEmail ИЛИ НЕ ЗначениеЗаполнено(ИмяПользователя) Тогда
		Сообщить(СтрШаблон("ИдентифицироватьПоEmail: %1, ИмяПользователя: %2", СервисПрофиляПользователя.ИдентифицироватьПоEmail, ИмяПользователя));
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СервисПрофиляПользователя.Эндпоинт) Тогда
		Сообщить("Сервис для определения email по имени пользователя включён, но не задан url - идентификатор пользователя Elma не будет заполнен.");
		Возврат "";
	КонецЕсли;
	
	Попытка
		EmailПользователя = АдресЭлПочтыПользователяЧерезСервисПрофиля(ИмяПользователя);
		Сообщить("EmailПользователя: " + EmailПользователя);
		Если НЕ ЗначениеЗаполнено(EmailПользователя) Тогда
			Возврат "";
		КонецЕсли;
		
		ИдПользователяElma = НайтиИдПользователяПоПочте(EmailПользователя);
		Если ЗначениеЗаполнено(ИдПользователяElma) Тогда
			Возврат ИдПользователяElma;
		КонецЕсли;
		
		Сообщить(СтрШаблон("Пользователь Elma с email %1 не найден - идентификатор пользователя Elma не будет заполнен.", EmailПользователя));
	Исключение
		Сообщить(СтрШаблон("Не удалось определить пользователя Elma по email (%1): %2", ИмяПользователя, ОписаниеОшибки()));
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

// Выделяет __id пользователя из тела ответа POST .../pub/v1/user/list по точному email
// (без учёта регистра). Если совпадения нет - Неопределено.
//
// Параметры:
//  ОтветСервиса - Соответствие - разобранный JSON ответа Elma (как после ПрочитатьJSON).
//  Email - Строка - искомый адрес.
//
// Возвращаемое значение:
//  Строка - __id найденного пользователя; иначе Неопределено.
Функция ИдПользователяЭлмаИзОтветаСпискаПользователей(ОтветСервиса, Email) Экспорт
	
	Если ОтветСервиса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РезультатОтвета = ОтветСервиса["result"];
	Если РезультатОтвета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Элементы = РезультатОтвета["result"];
	Если Элементы = Неопределено ИЛИ Элементы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	EmailНорм = НРег(СокрЛП(Email));
	Для Каждого Пользователь Из Элементы Цикл
		Если Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		EmailВЗаписи = Пользователь["email"];
		Если EmailВЗаписи <> Неопределено
			И НРег(СокрЛП(Строка(EmailВЗаписи))) = EmailНорм
			Тогда
			Ид = Пользователь["__id"];
			Если ЗначениеЗаполнено(Ид) Тогда
				Возврат Строка(Ид);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращаемое значение: Строка (__id) или Неопределено, если пользователь не найден или запрос не удался.
Функция НайтиИдПользователяПоПочте(Email) Экспорт
	
	Эндпоинт = СтрШаблон("%1/pub/v1/user/list", URL);
	
	ФильтрПоле = Новый Соответствие;
	ФильтрПоле.Вставить("email", СокрЛП(Email));
	
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("tf", ФильтрПоле);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("active", Истина);
	ТелоЗапросаJSON.Вставить("size", 20);
	ТелоЗапросаJSON.Вставить("filter", Фильтр);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	// Контракт Elma: при отсутствии пользователей - HTTP 200; в result.result бывает null или пустой массив (см. total).
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		ШаблонОшибкиСпискаПользователей = "Запрос списка пользователей Elma по email не удался. Код: %1. %2";
		Сообщить(СтрШаблон(ШаблонОшибкиСпискаПользователей, РезультатЗапроса.КодСостояния, РезультатЗапроса.Текст()));
		Возврат Неопределено;
	КонецЕсли;
	
	Ответ = ПрочитатьJsonОтветElma365(РезультатЗапроса.Текст());
	Возврат ИдПользователяЭлмаИзОтветаСпискаПользователей(Ответ, Email);
	
КонецФункции

#КонецОбласти

#Область ИзвлечениеДанныхИзОтчета

Функция ИзвлечьДанныеИсключения(Отчет)
	МассивОшибок = Отчет["errorInfo"]["applicationErrorInfo"]["errors"];
	Ошибка = МассивОшибок[0];
	Для Каждого ТекОшибка Из МассивОшибок Цикл
		Если ЗначениеЗаполнено(ТекОшибка[0]) Тогда
			Ошибка = ТекОшибка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТекстОшибки = Ошибка[0];
	ТипыОшибки = Ошибка[1];
	
	ЧастиПредставленияОшибки = СтрРазделить(ТекстОшибки, ":");
	МодульОшибки = ЧастиПредставленияОшибки[0];
	МодульОшибки = СтрЗаменить(МодульОшибки, "{", "");
	МодульОшибки = СтрЗаменить(МодульОшибки, "}", "");
	
	Если ЧастиПредставленияОшибки.Количество() > 1 Тогда
		ПредставлениеОшибки = СокрЛП(ЧастиПредставленияОшибки[1]);
	Иначе
		ПредставлениеОшибки = СокрЛП(ТекстОшибки);
	КонецЕсли;
	
	ДанныеИсключения = Новый Структура();
	
	ТипОшибки = "";
	Если ТипыОшибки.Количество() Тогда
		ТипОшибки = ТипыОшибки[0];
	КонецЕсли;
	
	ДанныеИсключения.Вставить("type", ТипОшибки);
	ДанныеИсключения.Вставить("value", ПредставлениеОшибки);
	ДанныеИсключения.Вставить("module", МодульОшибки);
	ДанныеИсключения.Вставить("stack", Отчет["errorInfo"]["applicationErrorInfo"]["stack"]);
	
	Возврат ДанныеИсключения;
КонецФункции

Функция ИмяПользователяИзОтчета(Отчет)
	ИмяПользователя = "";
	Если Отчет["sessionInfo"] <> Неопределено И Отчет["sessionInfo"]["userName"] <> Неопределено Тогда
		ИмяПользователя = Отчет["sessionInfo"]["userName"];
	КонецЕсли;
	Возврат ИмяПользователя;
КонецФункции

Функция ОписаниеПользовательскоеИзОтчета(Отчет)
	Описание = "";
	Если Отчет["errorInfo"] <> Неопределено И Отчет["errorInfo"]["userDescription"] <> Неопределено Тогда
		Описание = СокрЛП(Строка(Отчет["errorInfo"]["userDescription"]));
	КонецЕсли;
	Возврат Описание;
КонецФункции

#КонецОбласти

#Область ВнешнийСервисEmailПользователя

Функция АдресЭлПочтыПользователяЧерезСервисПрофиля(ИмяПользователя)
	
	Аутентификация = Новый Структура;
	Аутентификация.Вставить("Пользователь", СервисПрофиляПользователя.Логин);
	Аутентификация.Вставить("Пароль", СервисПрофиляПользователя.Пароль);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Аутентификация", Аутентификация);
	
	ИмяПоляПользователя = СервисПрофиляПользователя.ИмяПараметраЗапроса;
	Если НЕ ЗначениеЗаполнено(ИмяПоляПользователя) Тогда
		ИмяПоляПользователя = "userName";
	КонецЕсли;
	
	ПарсерJSON = Новый ПарсерJSON;
	
	Если ВРег(СервисПрофиляПользователя.МетодHTTP) = "GET" Тогда
		Разделитель = ?(СтрНайти(СервисПрофиляПользователя.Эндпоинт, "?") > 0, "&", "?");
		ИмяВСтрокеЗапроса = КодироватьСтроку(ИмяПользователя, СпособКодированияСтроки.КодировкаURL);
		ПолныйURL = СервисПрофиляПользователя.Эндпоинт + Разделитель + ИмяПоляПользователя + "=" + ИмяВСтрокеЗапроса;
		РезультатЗапроса = КоннекторHTTP.Get(ПолныйURL, Неопределено, ДопПараметры);
	Иначе
		ТелоJSON = Новый Соответствие;
		ТелоJSON.Вставить(ИмяПоляПользователя, ИмяПользователя);
		
		ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоJSON);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		ДопПараметры.Вставить("Заголовки", Заголовки);
		
		РезультатЗапроса = КоннекторHTTP.Post(СервисПрофиляПользователя.Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	КонецЕсли;
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		ШаблонОшибкиСервисаEmail = "Сервис email пользователя вернул код %1: %2";
		Сообщить(СтрШаблон(ШаблонОшибкиСервисаEmail, РезультатЗапроса.КодСостояния, РезультатЗапроса.Текст()));
		Возврат "";
	КонецЕсли;
	
	Ответ = ПрочитатьJsonОтветElma365(РезультатЗапроса.Текст());
	Если Ответ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	EmailИзОтвета = Ответ["email"];
	Если EmailИзОтвета = Неопределено ИЛИ НЕ ЗначениеЗаполнено(EmailИзОтвета) Тогда
		Сообщить("В ответе сервиса email нет поля email или оно пустое.");
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(EmailИзОтвета));
	
КонецФункции

#КонецОбласти

#Область JsonОтветElma365

// Разбирает JSON-ответ Elma365 Public API штатной ПрочитатьJSON (UUID остаются строками).
//
// Параметры:
//  ТекстJSON - Строка - тело ответа.
//
// Возвращаемое значение:
//  Произвольный - результат ПрочитатьJSON.
Функция ПрочитатьJsonОтветElma365(ТекстJSON)
	
	Если НЕ ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат Данные;
	
КонецФункции

// Приводит идентификатор к строке UUID в нижнем регистре для сравнения и отправки в Elma.
//
// Параметры:
//  Значение - Произвольный - элемент массива или одиночный идентификатор.
//
// Возвращаемое значение:
//  Строка - UUID в нижнем регистре; иначе Строка(Значение) для прочих типов.
Функция НормализоватьUuidВСтроку(Значение) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НРег(СокрЛП(Строка(Значение)));
	
КонецФункции

// Преобразует массив идентификаторов из ответа list Elma365 в массив строк.
//
// Параметры:
//  МассивUuid - Массив - значение поля ссылок на пользователей из JSON.
//
// Возвращаемое значение:
//  Массив - строковые UUID; исходный массив, если преобразование не требуется.
Функция НормализоватьМассивUuidВСтроки(МассивUuid) Экспорт
	
	Если ТипЗнч(МассивUuid) <> Тип("Массив") Тогда
		Возврат МассивUuid;
	КонецЕсли;
	
	Результат = Новый Массив;
	Для Каждого Элемент Из МассивUuid Цикл
		Результат.Добавить(НормализоватьUuidВСтроку(Элемент));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Нормализует в элементе приложения поле ссылок на пользователей (ПолеСсылкиНаПользователя).
//
// Параметры:
//  Элемент - Соответствие - элемент из ответа list Elma365.
Процедура НормализоватьПоляСсылкиПользователяВЭлементе(Элемент) Экспорт
	
	Если Элемент = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ПолеСсылкиНаПользователя) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПоля = Элемент[ПолеСсылкиНаПользователя];
	Если ТипЗнч(ЗначениеПоля) = Тип("Массив") Тогда
		Элемент.Вставить(ПолеСсылкиНаПользователя, НормализоватьМассивUuidВСтроки(ЗначениеПоля));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УтилитыСлиянияЗначений

Функция ДополнитьСтрокуСписка(ТекущаяСтрока, НовоеЗначение)
	
	Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока) Тогда
		Возврат НовоеЗначение;
	КонецЕсли;
	
	Если СтрНайти(ТекущаяСтрока, НовоеЗначение) > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекущаяСтрока + ", " + НовоеЗначение;
	
КонецФункции

// Добавляет значение в массив без дублей. Экспорт для юнит-тестов.
//
// Параметры:
//  ТекущийМассив - Массив, Неопределено - текущее значение поля (как из ответа list Elma).
//  НовоеЗначение - Произвольный - добавляемый идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив - новый массив с добавленным значением;
//  Неопределено - если добавлять нечего или значение уже есть в массиве.
Функция ДополнитьМассив(ТекущийМассив, НовоеЗначение) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НовоеСтрокой = НормализоватьUuidВСтроку(НовоеЗначение);
	Объединенный = Новый Массив;
	
	Если ТипЗнч(ТекущийМассив) = Тип("Массив") Тогда
		Если ТекущийМассив.Найти(НовоеСтрокой) <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого Эл Из ТекущийМассив Цикл
			Объединенный.Добавить(Эл);
		КонецЦикла;
	КонецЕсли;
	
	Объединенный.Добавить(НовоеСтрокой);
	
	Возврат Объединенный;
	
КонецФункции

Процедура ОбновитьСписокПользователей(ИдЭлемента, Элемент, ИмяДляПоляИмени, ИдДляПоляСсылки = "")
	
	ИспользоватьПолеСсылки = ЗначениеЗаполнено(ПолеСсылкиНаПользователя);
	
	Контекст = Новый Соответствие;
	
	Если ЗначениеЗаполнено(ПолеИмениПользователя) И ЗначениеЗаполнено(ИмяДляПоляИмени) Тогда
		СлияниеИмени = ДополнитьСтрокуСписка(Элемент[ПолеИмениПользователя], ИмяДляПоляИмени);
		Если СлияниеИмени <> Неопределено Тогда
			Контекст.Вставить(ПолеИмениПользователя, СлияниеИмени);
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользоватьПолеСсылки И ЗначениеЗаполнено(ИдДляПоляСсылки) Тогда
		Пользователи = ДополнитьМассив(Элемент[ПолеСсылкиНаПользователя], ИдДляПоляСсылки);
		Если Пользователи <> Неопределено Тогда
			Контекст.Вставить(ПолеСсылкиНаПользователя, Пользователи);
		КонецЕсли;
	КонецЕсли;
	
	Если Контекст.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/%4/update", URL, Раздел, Приложение, ИдЭлемента);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("context", Контекст);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния <> 200 И РезультатЗапроса.КодСостояния <> 204 Тогда
		ТелоОтвета = РезультатЗапроса.Текст();
		ШаблонОшибкиОбновленияПользователей = "Не удалось обновить список пользователей в Elma365. Код ответа: %1. Ответ: %2. ТелоЗапроса: %3";
		Сообщить(СтрШаблон(ШаблонОшибкиОбновленияПользователей, РезультатЗапроса.КодСостояния, ТелоОтвета, ТелоЗапроса));
	Иначе
		Сообщить(СтрШаблон("Список пользователей для ошибки %1 успешно обновлен. ТелоЗапроса: %2", ИдЭлемента, ТелоЗапроса));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФайлыИВложенияElma365

Функция ПолучитьИнформациюОФайле(ИдФайла)
	Эндпоинт = СтрШаблон("%1/pub/v1/disk/file/%2", URL, ИдФайла);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Get(Эндпоинт, Неопределено, ДопПараметры);
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		ПарсерJSON = Новый ПарсерJSON;
		Ответ = ПрочитатьJsonОтветElma365(РезультатЗапроса.Текст());
		Если Ответ["success"] = Истина И Ответ["file"] <> Неопределено Тогда
			Возврат Ответ["file"];
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗагрузитьФайлВElma365(ПутьКФайлу)
	
	Файл = Новый Файл(ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Размер = Файл.Размер();
	Если Размер = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(ДвоичныеДанные);
	ХэшСтрока = НРег(СтрЗаменить(Строка(Хеширование.ХешСумма), " ", ""));
	
	// Elma365 требует, чтобы хэш был в формате UUID (8-4-4-4-12)
	ХэшПрефикс = Лев(ХэшСтрока, 8) + "-" + Сред(ХэшСтрока, 9, 4) + "-" + Сред(ХэшСтрока, 13, 4);
	Хэш = ХэшПрефикс + "-" + Сред(ХэшСтрока, 17, 4) + "-" + Сред(ХэшСтрока, 21, 12);
	
	Эндпоинт = СтрШаблон("%1/pub/v1/disk/file/upload?hash=%2", URL, Хэш);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/octet-stream");
	
	СтрокаРазмер = СтрЗаменить(Строка(Размер), Символы.НПП, "");
	
	// Elma365 требует заголовок Content-Range для загрузки файлов в виде bytes 0-[size]/[size]
	Заголовки.Вставить("Content-Range", "bytes 0-" + СтрокаРазмер + "/" + СтрокаРазмер);
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ДвоичныеДанные, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния = 200 ИЛИ РезультатЗапроса.КодСостояния = 204 Тогда
		Возврат Хэш;
	КонецЕсли;
	
	ТелоОтвета = РезультатЗапроса.Текст();
	
	// Если мы загружаем файл с тем же хэшем повторно, Elma365 может вернуть 400 NoSuchUpload,
	// так как файл уже загружен. В этом случае мы считаем загрузку успешной.
	Если РезультатЗапроса.КодСостояния = 400 И СтрНайти(ТелоОтвета, "NoSuchUpload") > 0 Тогда
		Возврат Хэш;
	КонецЕсли;
	
	ШаблонОшибкиЗагрузкиФайла = "Не удалось загрузить файл %1 в Elma365. Код ответа: %2. Ответ сервера: %3";
	Сообщить(СтрШаблон(ШаблонОшибкиЗагрузкиФайла, Файл.Имя, РезультатЗапроса.КодСостояния, ТелоОтвета));
	Возврат Неопределено;
	
КонецФункции

Процедура ОбновитьВложения(ИдЭлемента, Элемент, ДанныеОтчетаОбОшибке)
	
	НужноОбновлять = Ложь;
	КонтекстОбновления = Новый Соответствие;
	
	// Получаем текущие файлы из элемента (если они есть)
	ТекущиеСкриншоты = Элемент["screenshots"];
	Если ТекущиеСкриншоты = Неопределено Тогда
		ТекущиеСкриншоты = Новый Массив;
	ИначеЕсли ТипЗнч(ТекущиеСкриншоты) = Тип("Строка") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(ТекущиеСкриншоты);
		ТекущиеСкриншоты = ВременныйМассив;
	КонецЕсли;
	
	ТекущиеВложения = Элемент["attachments"];
	Если ТекущиеВложения = Неопределено Тогда
		ТекущиеВложения = Новый Массив;
	ИначеЕсли ТипЗнч(ТекущиеВложения) = Тип("Строка") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(ТекущиеВложения);
		ТекущиеВложения = ВременныйМассив;
	КонецЕсли;
	
	// Получаем информацию о существующих файлах, чтобы проверить их хэши и имена
	СуществующиеФайлы = Новый Соответствие;
	
	Для Каждого ИдФайла Из ТекущиеСкриншоты Цикл
		Если ТипЗнч(ИдФайла) = Тип("Соответствие") Тогда
			Если ЗначениеЗаполнено(ИдФайла["hash"]) И ЗначениеЗаполнено(ИдФайла["name"]) Тогда
				КлючФайла = Строка(ИдФайла["hash"]) + "_" + Строка(ИдФайла["name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		Иначе
			Инфо = ПолучитьИнформациюОФайле(ИдФайла);
			Если Инфо <> Неопределено И ЗначениеЗаполнено(Инфо["hash"]) И ЗначениеЗаполнено(Инфо["__name"]) Тогда
				КлючФайла = Строка(Инфо["hash"]) + "_" + Строка(Инфо["__name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИдФайла Из ТекущиеВложения Цикл
		Если ТипЗнч(ИдФайла) = Тип("Соответствие") Тогда
			Если ЗначениеЗаполнено(ИдФайла["hash"]) И ЗначениеЗаполнено(ИдФайла["name"]) Тогда
				КлючФайла = Строка(ИдФайла["hash"]) + "_" + Строка(ИдФайла["name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		Иначе
			Инфо = ПолучитьИнформациюОФайле(ИдФайла);
			Если Инфо <> Неопределено И ЗначениеЗаполнено(Инфо["hash"]) И ЗначениеЗаполнено(Инфо["__name"]) Тогда
				КлючФайла = Строка(Инфо["hash"]) + "_" + Строка(Инфо["__name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	НовыеСкриншоты = Новый Массив;
	Для Каждого СущСкриншот Из ТекущиеСкриншоты Цикл
		НовыеСкриншоты.Добавить(СущСкриншот);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДанныеОтчетаОбОшибке.Скриншот) Тогда
		ХэшСкриншота = ЗагрузитьФайлВElma365(ДанныеОтчетаОбОшибке.Скриншот);
		Если ЗначениеЗаполнено(ХэшСкриншота) Тогда
			ФайлСкриншот = Новый Файл(ДанныеОтчетаОбОшибке.Скриншот);
			КлючФайла = Строка(ХэшСкриншота) + "_" + Строка(ФайлСкриншот.Имя);
			
			Если СуществующиеФайлы.Получить(КлючФайла) = Неопределено Тогда
				ВложениеСкриншот = Новый Соответствие;
				ВложениеСкриншот.Вставить("hash", ХэшСкриншота);
				ВложениеСкриншот.Вставить("name", ФайлСкриншот.Имя);
				НовыеСкриншоты.Добавить(ВложениеСкриншот);
				НужноОбновлять = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НужноОбновлять Тогда
		КонтекстОбновления.Вставить("screenshots", НовыеСкриншоты);
	КонецЕсли;
	
	// --- Обработка остальных файлов ---
	НовыеВложения = Новый Массив;
	Для Каждого СущВложение Из ТекущиеВложения Цикл
		НовыеВложения.Добавить(СущВложение);
	КонецЦикла;
	
	ФайлыОбновлены = Ложь;
	Если ДанныеОтчетаОбОшибке.Файлы <> Неопределено И ДанныеОтчетаОбОшибке.Файлы.Количество() > 0 Тогда
		Для Каждого ПутьКФайлу Из ДанныеОтчетаОбОшибке.Файлы Цикл
			ХэшФайла = ЗагрузитьФайлВElma365(ПутьКФайлу);
			Если ЗначениеЗаполнено(ХэшФайла) Тогда
				ФайлВложение = Новый Файл(ПутьКФайлу);
				КлючФайла = Строка(ХэшФайла) + "_" + Строка(ФайлВложение.Имя);
				
				Если СуществующиеФайлы.Получить(КлючФайла) = Неопределено Тогда
					Вложение = Новый Соответствие;
					Вложение.Вставить("hash", ХэшФайла);
					Вложение.Вставить("name", ФайлВложение.Имя);
					НовыеВложения.Добавить(Вложение);
					ФайлыОбновлены = Истина;
					НужноОбновлять = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ФайлыОбновлены Тогда
		КонтекстОбновления.Вставить("attachments", НовыеВложения);
	КонецЕсли;
	
	// --- Отправка запроса ---
	Если НужноОбновлять Тогда
		Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/%4/update", URL, Раздел, Приложение, ИдЭлемента);
		
		ТелоЗапросаJSON = Новый Соответствие;
		ТелоЗапросаJSON.Вставить("context", КонтекстОбновления);
		
		ПарсерJSON = Новый ПарсерJSON;
		ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("Content-Type", "application/json");
		
		ДопПараметры = Новый Структура("Заголовки", Заголовки);
		РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
		
		Если РезультатЗапроса.КодСостояния <> 200 И РезультатЗапроса.КодСостояния <> 204 Тогда
			ТелоОтвета = РезультатЗапроса.Текст();
			ШаблонОшибкиОбновленияВложений = "Не удалось обновить вложения в Elma365. Код ответа: %1. Ответ: %2";
			Сообщить(СтрШаблон(ШаблонОшибкиОбновленияВложений, РезультатЗапроса.КодСостояния, ТелоОтвета));
		Иначе
			Сообщить(СтрШаблон("Вложения для ошибки %1 успешно обновлены.", ИдЭлемента));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область МакросыИКонтекст

Функция ФорматироватьСтек(Стек)
	Если Стек = Неопределено ИЛИ ТипЗнч(Стек) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	Для Каждого ЭлементСтека Из Стек Цикл
		Если ТипЗнч(ЭлементСтека) = Тип("Массив") И ЭлементСтека.Количество() >= 2 Тогда
			ИмяФайла = ЭлементСтека[0];
			НомерСтроки = ЭлементСтека[1];
			Результат = Результат + СтрШаблон("%1:%2", ИмяФайла, НомерСтроки) + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ВычислитьЗначениеПоМакросу(Макрос, ДанныеОтчетаОбОшибке, ДанныеИсключения)
	Отчет = ДанныеОтчетаОбОшибке.Отчет;
	
	Если ТипЗнч(Макрос) <> Тип("Строка") Тогда
		Возврат Макрос;
	КонецЕсли;
	
	Результат = Макрос;
	
	Результат = СтрЗаменить(Результат, "{ErrorText}", ДанныеИсключения["value"]);
	Результат = СтрЗаменить(Результат, "{Module}", ДанныеИсключения["module"]);
	Результат = СтрЗаменить(Результат, "{AppVersion}", Отчет["serverInfo"]["appVersion"]);
	Результат = СтрЗаменить(Результат, "{User}", ИмяПользователяИзОтчета(Отчет));
	Результат = СтрЗаменить(Результат, "{UserDescription}", ОписаниеПользовательскоеИзОтчета(Отчет));
	
	Если СтрНайти(Результат, "{StackTrace}") > 0 Тогда
		Результат = СтрЗаменить(Результат, "{StackTrace}", ФорматироватьСтек(ДанныеИсключения["stack"]));
	КонецЕсли;
	
	Если СтрНайти(Результат, "{AdditionalInfo}") > 0 Тогда
		ДопИнфо = Отчет["additionalInfo"];
		Если ДопИнфо = Неопределено Тогда
			ДопИнфо = "";
		КонецЕсли;
		// Если ДопИнфо не строка, преобразуем в строку
		Результат = СтрЗаменить(Результат, "{AdditionalInfo}", Строка(ДопИнфо));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ЗаписатьИлиДополнитьМассивКонтекста(Контекст, ИмяКлюча, ЭлементыДляДобавления)
	
	Если Контекст[ИмяКлюча] = Неопределено Тогда
		Контекст.Вставить(ИмяКлюча, ЭлементыДляДобавления);
		Возврат;
	КонецЕсли;
	
	МассивКонтекста = Контекст[ИмяКлюча];
	Если ТипЗнч(МассивКонтекста) <> Тип("Массив") Тогда
		ВызватьИсключение("Значение ключа контекста не является массивом");
	КонецЕсли;
	
	Для Каждого Элемент Из ЭлементыДляДобавления Цикл
		МассивКонтекста.Добавить(Элемент);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьКонтекстСкриншотомПриСозданииЭлемента(Контекст, ДанныеОтчетаОбОшибке)
	
	Если НЕ ЗначениеЗаполнено(ДанныеОтчетаОбОшибке.Скриншот) Тогда
		Сообщить("Нет скриншота!");
		Возврат;
	КонецЕсли;
	
	ХэшСкриншота = ЗагрузитьФайлВElma365(ДанныеОтчетаОбОшибке.Скриншот);
	Сообщить("Хэш скриншота: " + ХэшСкриншота);
	
	Если НЕ ЗначениеЗаполнено(ХэшСкриншота) Тогда
		Возврат;
	КонецЕсли;
	
	ФайлСкриншот = Новый Файл(ДанныеОтчетаОбОшибке.Скриншот);
	ВложениеСкриншот = Новый Соответствие;
	ВложениеСкриншот.Вставить("hash", ХэшСкриншота);
	ВложениеСкриншот.Вставить("name", ФайлСкриншот.Имя);
	
	МассивСкриншотов = Новый Массив;
	МассивСкриншотов.Добавить(ВложениеСкриншот);
	
	// Если в маппинге не задано поле для скриншотов - вставляем массив; иначе дополняем существующий массив
	ЗаписатьИлиДополнитьМассивКонтекста(Контекст, "screenshots", МассивСкриншотов);
	
КонецПроцедуры

Процедура ДополнитьКонтекстВложениямиПриСозданииЭлемента(Контекст, ДанныеОтчетаОбОшибке)
	
	Если ДанныеОтчетаОбОшибке.Файлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеОтчетаОбОшибке.Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивВложений = Новый Массив;
	
	Для Каждого ПутьКФайлу Из ДанныеОтчетаОбОшибке.Файлы Цикл
		ХэшФайла = ЗагрузитьФайлВElma365(ПутьКФайлу);
		Если НЕ ЗначениеЗаполнено(ХэшФайла) Тогда
			Продолжить;
		КонецЕсли;
		ФайлВложение = Новый Файл(ПутьКФайлу);
		Вложение = Новый Соответствие;
		Вложение.Вставить("hash", ХэшФайла);
		Вложение.Вставить("name", ФайлВложение.Имя);
		МассивВложений.Добавить(Вложение);
	КонецЦикла;
	
	Если МассивВложений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьИлиДополнитьМассивКонтекста(Контекст, "attachments", МассивВложений);
	
КонецПроцедуры
Функция ПостроитьКонтекстСозданияЭлементаПриложения(ДанныеОтчетаОбОшибке, ДанныеИсключения, ИдентификаторОшибки)
	
	Контекст = Новый Соответствие;
	
	// Заполняем поле идентификатора для будущей группировки
	Если ЗначениеЗаполнено(ПолеИдентификатора) Тогда
		Контекст.Вставить(ПолеИдентификатора, ИдентификаторОшибки);
	КонецЕсли;
	
	ДанныеПользователя = ДанныеПользователяДляКонтекстаElma(ДанныеОтчетаОбОшибке.Отчет);
	Если ЗначениеЗаполнено(ПолеИмениПользователя) И ЗначениеЗаполнено(ДанныеПользователя.ИмяПользователя) Тогда
		Контекст.Вставить(ПолеИмениПользователя, ДанныеПользователя.ИмяПользователя);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПолеСсылкиНаПользователя) И ЗначениеЗаполнено(ДанныеПользователя.ИдентификаторПользователя) Тогда
		МассивИдентификаторов = Новый Массив;
		МассивИдентификаторов.Добавить(ДанныеПользователя.ИдентификаторПользователя);
		Контекст.Вставить(ПолеСсылкиНаПользователя, МассивИдентификаторов);
	КонецЕсли;
	
	// Заполняем остальные поля согласно настройкам маппинга
	Для Каждого Маппинг Из СоответствиеПолей Цикл
		ПолеElma = Маппинг.Ключ;
		ЗначениеМакроса = Маппинг.Значение;
		ВычисленноеЗначение = ВычислитьЗначениеПоМакросу(ЗначениеМакроса, ДанныеОтчетаОбОшибке, ДанныеИсключения);
		Контекст.Вставить(ПолеElma, ВычисленноеЗначение);
	КонецЦикла;
	
	ДополнитьКонтекстСкриншотомПриСозданииЭлемента(Контекст, ДанныеОтчетаОбОшибке);
	ДополнитьКонтекстВложениямиПриСозданииЭлемента(Контекст, ДанныеОтчетаОбОшибке);
	
	Возврат Контекст;
	
КонецФункции

Процедура ПроверитьКодОтветаСозданияЭлемента(РезультатЗапроса, Эндпоинт)
	
	Если РезультатЗапроса.КодСостояния = 200 ИЛИ РезультатЗапроса.КодСостояния = 204 Тогда
		Возврат;
	КонецЕсли;
	
	ТелоОтветаОшибки = РезультатЗапроса.Текст();
	ШаблонОшибкиСозданияЭлемента = "Не удалось создать элемент в Elma365. Код ответа: %1. URL: %2";
	Сообщение = СтрШаблон(ШаблонОшибкиСозданияЭлемента, РезультатЗапроса.КодСостояния, Эндпоинт);
	Если ЗначениеЗаполнено(ТелоОтветаОшибки) Тогда
		Сообщение = Сообщение + Символы.ПС + "Ответ: " + ТелоОтветаОшибки;
	КонецЕсли;
	ВызватьИсключение(Сообщение);
	
КонецПроцедуры
Функция ИзвлечьИдентификаторЭлементаИзОтветаСоздания(ТекстОтвета)
	
	Если НЕ ЗначениеЗаполнено(ТекстОтвета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ответ = ПрочитатьJsonОтветElma365(ТекстОтвета);
	Если Ответ = Неопределено ИЛИ Ответ["item"] = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ["item"]["__id"];
	
КонецФункции

Функция СоздатьЭлементПриложения(ДанныеОтчетаОбОшибке, ДанныеИсключения, ИдентификаторОшибки)
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/create", URL, Раздел, Приложение);
	Контекст = ПостроитьКонтекстСозданияЭлементаПриложения(ДанныеОтчетаОбОшибке, ДанныеИсключения, ИдентификаторОшибки);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("context", Контекст);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	ПроверитьКодОтветаСозданияЭлемента(РезультатЗапроса, Эндпоинт);
	
	Возврат ИзвлечьИдентификаторЭлементаИзОтветаСоздания(РезультатЗапроса.Текст());
	
КонецФункции

// Вызывает POST .../pub/v1/bpm/template/{namespace}/{code}/run (см. публичный Web API Elma365).
// Ошибки запроса не прерывают регистрацию ошибки: только сообщение в журнал.
//
Процедура ЗапуститьШаблонБизнесПроцессаПослеСозданияЭлемента(ИдЭлементаПриложения)
	
	Если НЕ ЗапускатьПроцессПослеСозданияЭлемента Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодШаблонаПроцесса) Тогда
		Сообщить("Запуск процесса Elma после создания элемента включён, но не задан код шаблона (start-process.code).");
		Возврат;
	КонецЕсли;
	
	РазделДляЗапуска = ?(ЗначениеЗаполнено(РазделШаблонаПроцесса), РазделШаблонаПроцесса, Раздел);
	Эндпоинт = СтрШаблон("%1/pub/v1/bpm/template/%2/%3/run", URL, РазделДляЗапуска, КодШаблонаПроцесса);
	
	КонтекстПроцесса = Новый Соответствие;
	Если ЗначениеЗаполнено(ИмяПеременнойКонтекстаПроцессаЭлементПриложения) Тогда
		МассивИдЭлементов = Новый Массив;
		МассивИдЭлементов.Добавить(Строка(ИдЭлементаПриложения));
		КонтекстПроцесса.Вставить(ИмяПеременнойКонтекстаПроцессаЭлементПриложения, МассивИдЭлементов);
	КонецЕсли;
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("context", КонтекстПроцесса);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	
	Попытка
		РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
		Если РезультатЗапроса.КодСостояния = 200 Тогда
			Сообщить(СтрШаблон("В Elma365 запущен бизнес-процесс %1/%2 после создания элемента приложения.", РазделДляЗапуска, КодШаблонаПроцесса));
		ИначеЕсли РезультатЗапроса.КодСостояния = 429 Тогда
			Сообщить("Elma365: достигнут лимит запуска процессов (HTTP 429).");
			Сообщить(РезультатЗапроса.Текст());
		Иначе
			Сообщить(СтрШаблон("Не удалось запустить процесс Elma365 (HTTP %1). URL: %2", РезультатЗапроса.КодСостояния, Эндпоинт));
			Сообщить(РезультатЗапроса.Текст());
		КонецЕсли;
	Исключение
		Сообщить(СтрШаблон("Ошибка HTTP при запуске процесса Elma365 после создания элемента: %1", ОписаниеОшибки()));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область Настройки

// Возвращает значение ключа узла настроек интеграции
//
// Параметры:
//  Узел - Соответствие, Структура, Неопределено - узел настроек (например фрагмент из appsettings.json).
//  Ключ - Строка - имя ключа в узле.
//
// Возвращаемое значение:
//  Произвольный - значение ключа; Неопределено, если узел не задан, для Структуры нет свойства с таким именем
//      или для остальных типов узла значение по ключу отсутствует (как у Соответствия).
Функция ЗначениеНастройки(Узел, Ключ)
	
	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Узел) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Узел.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Узел[Ключ];
	
КонецФункции

// Заполняет СервисПрофиляПользователя из вложенного узла настроек интеграции (reperrSettings.Integrations[*]).
// В узле: method (POST по умолчанию, GET - параметр в строке запроса), при необходимости - имя параметра имени пользователя.
//
// Параметры:
//  ПараметрыИнтеграции - Соответствие, Структура, Неопределено - узел одной интеграции из reperrSettings.
//      При Неопределено ничего не меняется.
//
Процедура ПрочитатьНастройкиСервисаПрофиляПользователя(ПараметрыИнтеграции)
	
	Если ПараметрыИнтеграции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УзелСервиса = ЗначениеНастройки(ПараметрыИнтеграции, "user-email-api");
	Если УзелСервиса = Неопределено
		ИЛИ ЗначениеНастройки(УзелСервиса, "enabled") <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	СервисПрофиляПользователя.ИдентифицироватьПоEmail = Истина;
	
	ЗначениеUrl = ЗначениеНастройки(УзелСервиса, "url");
	Если ЗначениеUrl <> Неопределено Тогда
		СервисПрофиляПользователя.Эндпоинт = Строка(ЗначениеUrl);
	КонецЕсли;
	
	ЗначениеUser = ЗначениеНастройки(УзелСервиса, "user");
	Если ЗначениеUser <> Неопределено Тогда
		СервисПрофиляПользователя.Логин = Строка(ЗначениеUser);
	КонецЕсли;
	
	ЗначениеПароль = ЗначениеНастройки(УзелСервиса, "password");
	Если ЗначениеПароль <> Неопределено Тогда
		СервисПрофиляПользователя.Пароль = Строка(ЗначениеПароль);
	КонецЕсли;
	
	ЗначениеМетод = ЗначениеНастройки(УзелСервиса, "method");
	Если ЗначениеМетод <> Неопределено И ЗначениеЗаполнено(Строка(ЗначениеМетод)) Тогда
		СервисПрофиляПользователя.МетодHTTP = ВРег(СокрЛП(Строка(ЗначениеМетод)));
	КонецЕсли;
	
	ЗначениеИмяПараметра = ЗначениеНастройки(УзелСервиса, "user-name-parameter");
	Если ЗначениеИмяПараметра <> Неопределено И ЗначениеЗаполнено(Строка(ЗначениеИмяПараметра)) Тогда
		СервисПрофиляПользователя.ИмяПараметраЗапроса = СокрЛП(Строка(ЗначениеИмяПараметра));
	КонецЕсли;
	
КонецПроцедуры

// Узел reperrSettings.Integrations.elma365.start-process: enabled, code, необязательно namespace и item-context-variable.
//
// Параметры:
//  ПараметрыИнтеграции - Соответствие, Структура, Неопределено - узел одной интеграции из reperrSettings.
//
Процедура ПрочитатьНастройкиЗапускаПроцессаПослеСозданияЭлемента(ПараметрыИнтеграции)
	
	Если ПараметрыИнтеграции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УзелПроцесса = ЗначениеНастройки(ПараметрыИнтеграции, "start-process");
	Если УзелПроцесса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеНастройки(УзелПроцесса, "enabled") <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	ЗапускатьПроцессПослеСозданияЭлемента = Истина;
	
	ЗначениеРазделаШаблона = ЗначениеНастройки(УзелПроцесса, "namespace");
	Если ЗначениеРазделаШаблона <> Неопределено И ЗначениеЗаполнено(Строка(ЗначениеРазделаШаблона)) Тогда
		РазделШаблонаПроцесса = СокрЛП(Строка(ЗначениеРазделаШаблона));
	КонецЕсли;
	
	ЗначениеКодаШаблона = ЗначениеНастройки(УзелПроцесса, "code");
	Если ЗначениеКодаШаблона <> Неопределено Тогда
		КодШаблонаПроцесса = СокрЛП(Строка(ЗначениеКодаШаблона));
	КонецЕсли;
	
	ЗначениеИмениПеременной = ЗначениеНастройки(УзелПроцесса, "item-context-variable");
	Если ЗначениеИмениПеременной <> Неопределено И ЗначениеЗаполнено(Строка(ЗначениеИмениПеременной)) Тогда
		ИмяПеременнойКонтекстаПроцессаЭлементПриложения = СокрЛП(Строка(ЗначениеИмениПеременной));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
