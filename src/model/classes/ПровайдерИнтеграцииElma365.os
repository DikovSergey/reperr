#Использовать 1connector

// URL сервера Elma365
Перем URL;

// Токен авторизации (API Key)
Перем Токен;

// Код раздела (namespace)
Перем Раздел;

// Код приложения (code)
Перем Приложение;

// Имя поля в Elma365, которое будет хранить идентификатор (хэш) ошибки для группировки
Перем ПолеИдентификатора;

// Имя поля в Elma365 для хранения списка пользователей
Перем ПолеИмениПользователя;

// Соответствие полей: Ключ - поле в Elma365, Значение - макрос или путь к данным
Перем СоответствиеПолей;

// Поддерживает ли провайдер получение представления существующей ошибки
Перем ПоддерживаетПолучениеПредставленияОшибки;

// Опционально: получить email по имени пользователя через внешний REST API (Basic) и подставить в Elma идентификатор пользователя, найденного по email
Перем РазрешатьПользователяПоEmail;
Перем URLСервисаEmailПользователя;
Перем ЛогинСервисаEmailПользователя;
Перем ПарольСервисаEmailПользователя;

// Узел настроек из JSON (Соответствие) или явная Структура в тестах: для Структуры ключ проверяется через .Свойство.
Функция ЗначениеКлючаУзлаНастроекИнтеграции(Узел, Ключ)
	
	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Узел) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Узел.Свойство(Ключ, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Узел[Ключ];
	
КонецФункции

// Инициализирует провайдер: значения по умолчанию; при передаче Параметры - поля из узла интеграции в appsettings.json.
//
// Параметры:
//  Параметры - Соответствие, Структура, Неопределено - настройки одной интеграции из reperrSettings.Integrations (как в JSON).
//      При Неопределено остаются только значения по умолчанию
//
Процедура ПриСозданииОбъекта(Параметры = Неопределено)

	СоответствиеПолей = Новый Соответствие;
	ПоддерживаетПолучениеПредставленияОшибки = Ложь;
	РазрешатьПользователяПоEmail = Ложь;
	URLСервисаEmailПользователя = "";
	ЛогинСервисаEmailПользователя = "";
	ПарольСервисаEmailПользователя = "";

	Если Параметры <> Неопределено Тогда
		URL(Параметры["url"]);
		Токен(Параметры["token"]);
		Раздел(Параметры["namespace"]);
		Приложение(Параметры["app"]);
		ПолеИдентификатора(Параметры["identifierField"]);
		ПолеИмениПользователя(Параметры["userNameField"]);
		СоответствиеПолей(Параметры["fieldMapping"]);
		ПоддерживаетПолучениеПредставленияОшибки(Параметры["supportGetExistingError"] = Истина);
		НастройкиAPIEmail = ЗначениеКлючаУзлаНастроекИнтеграции(Параметры, "userEmailApi");
		Если НастройкиAPIEmail <> Неопределено И ЗначениеКлючаУзлаНастроекИнтеграции(НастройкиAPIEmail, "enabled") = Истина Тогда
			РазрешатьПользователяПоEmail = Истина;
			ЗначениеUrl = ЗначениеКлючаУзлаНастроекИнтеграции(НастройкиAPIEmail, "url");
			Если ЗначениеUrl <> Неопределено Тогда
				URLСервисаEmailПользователя = Строка(ЗначениеUrl);
			КонецЕсли;
			ЗначениеUser = ЗначениеКлючаУзлаНастроекИнтеграции(НастройкиAPIEmail, "user");
			Если ЗначениеUser <> Неопределено Тогда
				ЛогинСервисаEmailПользователя = Строка(ЗначениеUser);
			КонецЕсли;
			ЗначениеПароль = ЗначениеКлючаУзлаНастроекИнтеграции(НастройкиAPIEmail, "password");
			Если ЗначениеПароль <> Неопределено Тогда
				ПарольСервисаEmailПользователя = Строка(ЗначениеПароль);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Устанавливает признак поддержки получения представления ошибки
//
// Параметры:
//  вхЗначение - Булево, Неопределено - Новое значение признака; при Неопределено значение не изменяется.
//
// Возвращаемое значение:
//  ПровайдерИнтеграцииElma365 - текущий объект (цепочка вызовов).
Функция ПоддерживаетПолучениеПредставленияОшибки(вхЗначение = Неопределено) Экспорт
	Если вхЗначение <> Неопределено Тогда
		ПоддерживаетПолучениеПредставленияОшибки = вхЗначение;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Возвращает признак поддержки получения представления существующей ошибки
//
// Возвращаемое значение:
//  Булево
Функция ПоддерживаетсяПолучениеПредставленияОшибки() Экспорт
	Возврат ПоддерживаетПолучениеПредставленияОшибки;
КонецФункции

// Возвращает признак отправки каждого отчета независимо от отпечатка ошибки
//
// Возвращаемое значение:
//  Булево
Функция ОтправлятьКаждыйОтчет() Экспорт
	Возврат Истина;
КонецФункции

// Устанавливает базовый URL Elma365
Функция URL(вхURL) Экспорт
	Если Прав(вхURL, 1) = "/" Тогда
		URL = Лев(вхURL, СтрДлина(вхURL) - 1);
	Иначе
		URL = вхURL;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает токен авторизации
Функция Токен(вхТокен) Экспорт
	Токен = вхТокен;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает код раздела
Функция Раздел(вхРаздел) Экспорт
	Раздел = вхРаздел;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает код приложения
Функция Приложение(вхПриложение) Экспорт
	Приложение = вхПриложение;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает имя поля для идентификатора (хэша) ошибки
Функция ПолеИдентификатора(вхПолеИдентификатора) Экспорт
	ПолеИдентификатора = вхПолеИдентификатора;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает имя поля для хранения списка пользователей
Функция ПолеИмениПользователя(вхПолеИмениПользователя) Экспорт
	ПолеИмениПользователя = вхПолеИмениПользователя;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает соответствие полей
Функция СоответствиеПолей(вхСоответствиеПолей) Экспорт
	Если ТипЗнч(вхСоответствиеПолей) = Тип("Соответствие") Тогда
		СоответствиеПолей = вхСоответствиеПолей;
	ИначеЕсли ТипЗнч(вхСоответствиеПолей) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из вхСоответствиеПолей Цикл
			СоответствиеПолей.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Основной метод регистрации ошибки
Функция ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке) Экспорт
	
	Сообщить("Регистрирую ошибку в Elma365");
	
	Отчет = ДанныеОтчетаОбОшибке.Отчет;
	ДанныеИсключения = ИзвлечьДанныеИсключения(Отчет);
	
	// Формируем уникальный хэш ошибки для группировки
	ОтпечатокОшибки = ДанныеОтчетаОбОшибке["fingerprint"];
	Сообщить(СтрШаблон("Отпечаток oшибки в Elma365 (ID: %1)", ОтпечатокОшибки));
	
	// Проверяем, существует ли уже такая ошибка в Elma365
	ЭлементСуществующейОшибки = НайтиЭлементПоИдентификатору(ОтпечатокОшибки);
	
	Если ЭлементСуществующейОшибки <> Неопределено Тогда
		ИдСуществующейОшибки = ЭлементСуществующейОшибки["__id"];
		Сообщить(СтрШаблон("Ошибка уже зарегистрирована в Elma365 (ID: %1). Пропускаем создание дубля.", ИдСуществующейОшибки));
		
		ИмяПользователя = ПолучитьЗначениеДляПоляПользователейElma(Отчет);
		ОбновитьСписокПользователей(ИдСуществующейОшибки, ЭлементСуществующейОшибки, ИмяПользователя);
		ОбновитьВложения(ИдСуществующейОшибки, ЭлементСуществующейОшибки, ДанныеОтчетаОбОшибке);
		
		Возврат ИдСуществующейОшибки;
	КонецЕсли;
	
	// Создаем новый элемент приложения
	ИдСозданногоЭлемента = СоздатьЭлементПриложения(ДанныеОтчетаОбОшибке, ДанныеИсключения, ОтпечатокОшибки);
	
	Возврат ИдСозданногоЭлемента;
	
КонецФункции

// Возвращает пользовательское сообщение о том, что ошибка уже зарегистрирована
Функция ПолучитьСообщениеОСуществующейОшибке(ЗапросИнфоОбОшибке, ИдОшибки) Экспорт
	
	ПредставлениеОшибки = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ПолеИдентификатора) Тогда
		Возврат ПредставлениеОшибки;
	КонецЕсли;
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/list", URL, Раздел, Приложение);
	
	ФильтрПоле = Новый Соответствие;
	ФильтрПоле.Вставить(ПолеИдентификатора, ЗапросИнфоОбОшибке["x_fingerprint"]);
	
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("tf", ФильтрПоле);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("size", 1);
	ТелоЗапросаJSON.Вставить("active", Истина);
	ТелоЗапросаJSON.Вставить("filter", Фильтр);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		Ответ = ПарсерJSON.ПрочитатьJSON(РезультатЗапроса.Текст());
		РезультатОтвета = Ответ["result"];
		Если РезультатОтвета <> Неопределено Тогда
			Элементы = РезультатОтвета["result"];
			Если Элементы <> Неопределено И Элементы.Количество() > 0 Тогда
				ИмяЭлемента = Элементы[0]["__name"];
				Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
					ПредставлениеОшибки = СтрШаблон("Данная ошибка уже зарегистрирована в Elma: %1", ИмяЭлемента);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Сообщить("Не удалось получить представление ошибки в Elma365. Код ответа: " + РезультатЗапроса.КодСостояния);
		Сообщить("Ответ: " + РезультатЗапроса.Текст());
	КонецЕсли;
	
	Возврат ПредставлениеОшибки;
	
КонецФункции

Функция НайтиЭлементПоИдентификатору(ИдентификаторОшибки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПолеИдентификатора) Тогда
		Возврат Неопределено; // Если поле не задано, не группируем
	КонецЕсли;
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/list", URL, Раздел, Приложение);
	
	ФильтрПоле = Новый Соответствие;
	ФильтрПоле.Вставить(ПолеИдентификатора, ИдентификаторОшибки);
	
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("tf", ФильтрПоле);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("active", Истина);
	ТелоЗапросаJSON.Вставить("filter", Фильтр);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		Ответ = ПарсерJSON.ПрочитатьJSON(РезультатЗапроса.Текст());
		РезультатОтвета = Ответ["result"];
		Если РезультатОтвета <> Неопределено Тогда
			Элементы = РезультатОтвета["result"];
			Если Элементы <> Неопределено И Элементы.Количество() > 0 Тогда
				Возврат Элементы[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СоздатьЭлементПриложения(ДанныеОтчетаОбОшибке, ДанныеИсключения, ИдентификаторОшибки)
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/create", URL, Раздел, Приложение);
	
	Контекст = Новый Соответствие;
	
	// Заполняем поле идентификатора для будущей группировки
	Если ЗначениеЗаполнено(ПолеИдентификатора) Тогда
		Контекст.Вставить(ПолеИдентификатора, ИдентификаторОшибки);
	КонецЕсли;
	
	ИмяПользователя = ПолучитьЗначениеДляПоляПользователейElma(ДанныеОтчетаОбОшибке.Отчет);
	Если ЗначениеЗаполнено(ИмяПользователя) И ЗначениеЗаполнено(ПолеИмениПользователя) Тогда
		Контекст.Вставить(ПолеИмениПользователя, ИмяПользователя);
	КонецЕсли;
	
	// Заполняем остальные поля согласно настройкам маппинга
	Для Каждого Маппинг Из СоответствиеПолей Цикл
		ПолеElma = Маппинг.Ключ;
		ЗначениеМакроса = Маппинг.Значение;
		
		ВычисленноеЗначение = ВычислитьЗначениеПоМакросу(ЗначениеМакроса, ДанныеОтчетаОбОшибке, ДанныеИсключения);
		Контекст.Вставить(ПолеElma, ВычисленноеЗначение);
	КонецЦикла;
	
	// Загружаем скриншот, если он есть
	Если ЗначениеЗаполнено(ДанныеОтчетаОбОшибке.Скриншот) Тогда
		ХэшСкриншота = ЗагрузитьФайлВElma365(ДанныеОтчетаОбОшибке.Скриншот);
		Сообщить("Хэш скриншота: " + ХэшСкриншота);
		Если ЗначениеЗаполнено(ХэшСкриншота) Тогда
			ФайлСкриншот = Новый Файл(ДанныеОтчетаОбОшибке.Скриншот);
			ВложениеСкриншот = Новый Соответствие;
			ВложениеСкриншот.Вставить("hash", ХэшСкриншота);
			ВложениеСкриншот.Вставить("name", ФайлСкриншот.Имя);
			
			МассивСкриншотов = Новый Массив;
			МассивСкриншотов.Добавить(ВложениеСкриншот);
			
			// Если в маппинге не задано поле для скриншотов, используем системное __file или пользовательское screenshots
			Если Контекст["screenshots"] = Неопределено Тогда
				Контекст.Вставить("screenshots", МассивСкриншотов);
			Иначе
				// Если поле уже есть (например, пустой массив из маппинга), добавляем в него
				МассивСкриншотовКонтекста = Контекст["screenshots"];
				Если ТипЗнч(МассивСкриншотовКонтекста) = Тип("Массив") Тогда
					МассивСкриншотовКонтекста.Добавить(ВложениеСкриншот);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Сообщить("Нет скриншота!");
	КонецЕсли;
	
	// Загружаем остальные файлы (report.json и т.д.)
	Если ДанныеОтчетаОбОшибке.Файлы <> Неопределено И ДанныеОтчетаОбОшибке.Файлы.Количество() > 0 Тогда
		МассивВложений = Новый Массив;
		
		Для Каждого ПутьКФайлу Из ДанныеОтчетаОбОшибке.Файлы Цикл
			ХэшФайла = ЗагрузитьФайлВElma365(ПутьКФайлу);
			Если ЗначениеЗаполнено(ХэшФайла) Тогда
				ФайлВложение = Новый Файл(ПутьКФайлу);
				Вложение = Новый Соответствие;
				Вложение.Вставить("hash", ХэшФайла);
				Вложение.Вставить("name", ФайлВложение.Имя);
				МассивВложений.Добавить(Вложение);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивВложений.Количество() > 0 Тогда
			Если Контекст["attachments"] = Неопределено Тогда
				Контекст.Вставить("attachments", МассивВложений);
			Иначе
				МассивВложенийКонтекста = Контекст["attachments"];
				Если ТипЗнч(МассивВложенийКонтекста) = Тип("Массив") Тогда
					Для Каждого Вл Из МассивВложений Цикл
						МассивВложенийКонтекста.Добавить(Вл);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("context", Контекст);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния <> 200 И РезультатЗапроса.КодСостояния <> 204 Тогда
		ТелоОтвета = РезультатЗапроса.Текст();
		Сообщение = СтрШаблон("Не удалось создать элемент в Elma365. Код ответа: %1. URL: %2", РезультатЗапроса.КодСостояния, Эндпоинт);
		Если ЗначениеЗаполнено(ТелоОтвета) Тогда
			Сообщение = Сообщение + Символы.ПС + "Ответ: " + ТелоОтвета;
		КонецЕсли;
		ВызватьИсключение(Сообщение);
	КонецЕсли;
	
	ТелоОтвета = РезультатЗапроса.Текст();
	Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		Ответ = ПарсерJSON.ПрочитатьJSON(ТелоОтвета);
		Если Ответ <> Неопределено И Ответ["item"] <> Неопределено Тогда
			Возврат Ответ["item"]["__id"];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗагрузитьФайлВElma365(ПутьКФайлу)
	
	Файл = Новый Файл(ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Размер = Файл.Размер();
	Если Размер = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(ДвоичныеДанные);
	ХэшСтрока = НРег(СтрЗаменить(Строка(Хеширование.ХешСумма), " ", ""));
	
	// Elma365 требует, чтобы хэш был в формате UUID (8-4-4-4-12)
	Хэш = Лев(ХэшСтрока, 8) + "-" + Сред(ХэшСтрока, 9, 4) + "-" + Сред(ХэшСтрока, 13, 4) + "-" + Сред(ХэшСтрока, 17, 4) + "-" + Сред(ХэшСтрока, 21, 12);
	
	Эндпоинт = СтрШаблон("%1/pub/v1/disk/file/upload?hash=%2", URL, Хэш);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/octet-stream");
	
	СтрокаРазмер = СтрЗаменить(Строка(Размер), Символы.НПП, "");
	
	// Elma365 требует заголовок Content-Range для загрузки файлов в виде bytes 0-[size]/[size]
	Заголовки.Вставить("Content-Range", "bytes 0-" + СтрокаРазмер + "/" + СтрокаРазмер);
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ДвоичныеДанные, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния = 200 ИЛИ РезультатЗапроса.КодСостояния = 204 Тогда
		Возврат Хэш;
	КонецЕсли;
	
	ТелоОтвета = РезультатЗапроса.Текст();
	
	// Если мы загружаем файл с тем же хэшем повторно, Elma365 может вернуть 400 NoSuchUpload,
	// так как файл уже загружен. В этом случае мы считаем загрузку успешной.
	Если РезультатЗапроса.КодСостояния = 400 И СтрНайти(ТелоОтвета, "NoSuchUpload") > 0 Тогда
		Возврат Хэш;
	КонецЕсли;
	
	Сообщить(СтрШаблон("Не удалось загрузить файл %1 в Elma365. Код ответа: %2. Ответ сервера: %3", Файл.Имя, РезультатЗапроса.КодСостояния, ТелоОтвета));
	Возврат Неопределено;
	
КонецФункции

Функция ВычислитьЗначениеПоМакросу(Макрос, ДанныеОтчетаОбОшибке, ДанныеИсключения)
	Отчет = ДанныеОтчетаОбОшибке.Отчет;
	
	Если ТипЗнч(Макрос) <> Тип("Строка") Тогда
		Возврат Макрос;
	КонецЕсли;
	
	Результат = Макрос;
	
	Если СтрНайти(Результат, "{ErrorText}") > 0 Тогда
		Результат = СтрЗаменить(Результат, "{ErrorText}", ДанныеИсключения["value"]);
	КонецЕсли;
	
	Если СтрНайти(Результат, "{Module}") > 0 Тогда
		Результат = СтрЗаменить(Результат, "{Module}", ДанныеИсключения["module"]);
	КонецЕсли;
	
	Если СтрНайти(Результат, "{AppVersion}") > 0 Тогда
		Результат = СтрЗаменить(Результат, "{AppVersion}", Отчет["serverInfo"]["appVersion"]);
	КонецЕсли;
	
	Если СтрНайти(Результат, "{User}") > 0 Тогда
		ИмяПользователя = "";
		Если Отчет["sessionInfo"] <> Неопределено Тогда
			ИмяПользователя = Отчет["sessionInfo"]["userName"];
		КонецЕсли;
		Результат = СтрЗаменить(Результат, "{User}", ИмяПользователя);
	КонецЕсли;
	
	Если СтрНайти(Результат, "{UserDescription}") > 0 Тогда
		ОписаниеПользователя = "";
		Если Отчет["errorInfo"] <> Неопределено И Отчет["errorInfo"]["userDescription"] <> Неопределено Тогда
			ОписаниеПользователя = Отчет["errorInfo"]["userDescription"];
		КонецЕсли;
		Результат = СтрЗаменить(Результат, "{UserDescription}", ОписаниеПользователя);
	КонецЕсли;
	
	Если СтрНайти(Результат, "{StackTrace}") > 0 Тогда
		Результат = СтрЗаменить(Результат, "{StackTrace}", ФорматироватьСтек(ДанныеИсключения["stack"]));
	КонецЕсли;
	
	Если СтрНайти(Результат, "{AdditionalInfo}") > 0 Тогда
		ДопИнфо = Отчет["additionalInfo"];
		Если ДопИнфо = Неопределено Тогда
			ДопИнфо = "";
		КонецЕсли;
		// Если ДопИнфо не строка, преобразуем в строку
		Результат = СтрЗаменить(Результат, "{AdditionalInfo}", Строка(ДопИнфо));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьИмяПользователя(Отчет)
	ИмяПользователя = "";
	Если Отчет["sessionInfo"] <> Неопределено И Отчет["sessionInfo"]["userName"] <> Неопределено Тогда
		ИмяПользователя = Отчет["sessionInfo"]["userName"];
	КонецЕсли;
	Возврат ИмяПользователя;
КонецФункции

// Возвращает строку для поля списка пользователей в Elma: при включённом userEmailApi - __id пользователя Elma, иначе имя пользователя из отчёта.
Функция ПолучитьЗначениеДляПоляПользователейElma(Отчет) Экспорт
	
	ИмяПользователя = ПолучитьИмяПользователя(Отчет);
	
	Если НЕ РазрешатьПользователяПоEmail ИЛИ НЕ ЗначениеЗаполнено(ИмяПользователя) Тогда
		Возврат ИмяПользователя;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(URLСервисаEmailПользователя) Тогда
		Сообщить("userEmailApi включён, но не задан url - подставляю имя пользователя вместо идентификатора Elma.");
		Возврат ИмяПользователя;
	КонецЕсли;
	
	Попытка
		EmailПользователя = ПолучитьEmailПользователяЧерезВнешнийAPI(ИмяПользователя);
		Если НЕ ЗначениеЗаполнено(EmailПользователя) Тогда
			Возврат ИмяПользователя;
		КонецЕсли;
		
		ИдПользователяElma = НайтиИдПользователяElmaПоEmail(EmailПользователя);
		Если ЗначениеЗаполнено(ИдПользователяElma) Тогда
			Возврат ИдПользователяElma;
		КонецЕсли;
		
		Сообщить(СтрШаблон("Пользователь Elma с email %1 не найден, подставляю имя: %2", EmailПользователя, ИмяПользователя));
	Исключение
		Сообщить(СтрШаблон("Не удалось разрешить пользователя Elma по email (%1): %2", ИмяПользователя, ОписаниеОшибки()));
	КонецПопытки;
	
	Возврат ИмяПользователя;
	
КонецФункции

Функция ПолучитьEmailПользователяЧерезВнешнийAPI(ИмяПользователя)
	
	ТелоJSON = Новый Соответствие;
	ТелоJSON.Вставить("userName", ИмяПользователя);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	
	Аутентификация = Новый Структура;
	Аутентификация.Вставить("Пользователь", ЛогинСервисаEmailПользователя);
	Аутентификация.Вставить("Пароль", ПарольСервисаEmailПользователя);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Заголовки", Заголовки);
	ДопПараметры.Вставить("Аутентификация", Аутентификация);
	
	РезультатЗапроса = КоннекторHTTP.Post(URLСервисаEmailПользователя, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Сообщить(СтрШаблон("Сервис email пользователя вернул код %1: %2", РезультатЗапроса.КодСостояния, РезультатЗапроса.Текст()));
		Возврат "";
	КонецЕсли;
	
	Ответ = ПарсерJSON.ПрочитатьJSON(РезультатЗапроса.Текст());
	Если Ответ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	EmailИзОтвета = Ответ["userEmail"];
	Если EmailИзОтвета = Неопределено ИЛИ НЕ ЗначениеЗаполнено(EmailИзОтвета) Тогда
		Сообщить("В ответе сервиса email нет поля userEmail или оно пустое.");
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(EmailИзОтвета));
	
КонецФункции

// Выделяет __id пользователя из тела ответа POST .../pub/v1/user/list по точному email (без учёта регистра), иначе - первый элемент списка.
//
// Параметры:
//  ОтветСервиса - Соответствие - разобранный JSON ответа Elma (как после ПрочитатьJSON).
//  Email - Строка - искомый адрес.
//
// Возвращаемое значение:
//  Строка - __id или пустая строка.
Функция ИдПользователяElmaИзОтветаСпискаПользователей(ОтветСервиса, Email) Экспорт
	
	Если ОтветСервиса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	РезультатОтвета = ОтветСервиса["result"];
	Если РезультатОтвета = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Элементы = РезультатОтвета["result"];
	Если Элементы = Неопределено ИЛИ Элементы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	EmailНорм = НРег(СокрЛП(Email));
	Для Каждого Пользователь Из Элементы Цикл
		Если Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		EmailВЗаписи = Пользователь["email"];
		Если EmailВЗаписи <> Неопределено
			И НРег(СокрЛП(Строка(EmailВЗаписи))) = EmailНорм
			Тогда
			Ид = Пользователь["__id"];
			Если ЗначениеЗаполнено(Ид) Тогда
				Возврат Строка(Ид);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Фильтр tf может работать как подстрока - берём первого, если точного совпадения нет
	Первый = Элементы[0];
	Если Первый <> Неопределено И ЗначениеЗаполнено(Первый["__id"]) Тогда
		Возврат Строка(Первый["__id"]);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция НайтиИдПользователяElmaПоEmail(Email) Экспорт
	
	Эндпоинт = СтрШаблон("%1/pub/v1/user/list", URL);
	
	ФильтрПоле = Новый Соответствие;
	ФильтрПоле.Вставить("email", СокрЛП(Email));
	
	Фильтр = Новый Соответствие;
	Фильтр.Вставить("tf", ФильтрПоле);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("active", Истина);
	ТелоЗапросаJSON.Вставить("size", 20);
	ТелоЗапросаJSON.Вставить("filter", Фильтр);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	// Контракт Elma: при отсутствии пользователей - HTTP 200; в result.result бывает null или пустой массив (см. total).
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Сообщить(СтрШаблон("Запрос списка пользователей Elma по email не удался. Код: %1. %2", РезультатЗапроса.КодСостояния, РезультатЗапроса.Текст()));
		Возврат "";
	КонецЕсли;
	
	Ответ = ПарсерJSON.ПрочитатьJSON(РезультатЗапроса.Текст());
	Возврат ИдПользователяElmaИзОтветаСпискаПользователей(Ответ, Email);
	
КонецФункции

Процедура ОбновитьСписокПользователей(ИдЭлемента, Элемент, НовоеИмяПользователя)
	
	Если НЕ ЗначениеЗаполнено(ПолеИмениПользователя) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовоеИмяПользователя) Тогда
		Возврат;
	КонецЕсли;
	
	НовоеЗначение = НовоеИмяПользователя;
	
	ТекущиеПользователи = Элемент[ПолеИмениПользователя];
	Если ТипЗнч(ТекущиеПользователи) = Тип("Массив") Тогда
		Если ТекущиеПользователи.Найти(НовоеИмяПользователя) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		ТекущиеПользователи.Добавить(НовоеИмяПользователя);
		НовоеЗначение = ТекущиеПользователи;
	КонецЕсли;
	
	Если ТипЗнч(ТекущиеПользователи) = Тип("Строка")
		И ЗначениеЗаполнено(ТекущиеПользователи)
		Тогда
		Если СтрНайти(ТекущиеПользователи, НовоеИмяПользователя) > 0 Тогда
			Возврат;
		КонецЕсли;
		НовоеЗначение = ТекущиеПользователи + ", " + НовоеИмяПользователя;
	КонецЕсли;
	
	Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/%4/update", URL, Раздел, Приложение, ИдЭлемента);
	
	Контекст = Новый Соответствие;
	Контекст.Вставить(ПолеИмениПользователя, НовоеЗначение);
	
	ТелоЗапросаJSON = Новый Соответствие;
	ТелоЗапросаJSON.Вставить("context", Контекст);
	
	ПарсерJSON = Новый ПарсерJSON;
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
	
	Если РезультатЗапроса.КодСостояния <> 200 И РезультатЗапроса.КодСостояния <> 204 Тогда
		ТелоОтвета = РезультатЗапроса.Текст();
		Сообщить(СтрШаблон("Не удалось обновить список пользователей в Elma365. Код ответа: %1. Ответ: %2", РезультатЗапроса.КодСостояния, ТелоОтвета));
	Иначе
		Сообщить(СтрШаблон("Список пользователей для ошибки %1 успешно обновлен.", ИдЭлемента));
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИнформациюОФайле(ИдФайла)
	Эндпоинт = СтрШаблон("%1/pub/v1/disk/file/%2", URL, ИдФайла);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	
	ДопПараметры = Новый Структура("Заголовки", Заголовки);
	РезультатЗапроса = КоннекторHTTP.Get(Эндпоинт, Неопределено, ДопПараметры);
	Если РезультатЗапроса.КодСостояния = 200 Тогда
		ПарсерJSON = Новый ПарсерJSON;
		Ответ = ПарсерJSON.ПрочитатьJSON(РезультатЗапроса.Текст());
		Если Ответ["success"] = Истина И Ответ["file"] <> Неопределено Тогда
			Возврат Ответ["file"];
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ОбновитьВложения(ИдЭлемента, Элемент, ДанныеОтчетаОбОшибке)
	
	НужноОбновлять = Ложь;
	КонтекстОбновления = Новый Соответствие;
	
	// Получаем текущие файлы из элемента (если они есть)
	ТекущиеСкриншоты = Элемент["screenshots"];
	Если ТекущиеСкриншоты = Неопределено Тогда
		ТекущиеСкриншоты = Новый Массив;
	ИначеЕсли ТипЗнч(ТекущиеСкриншоты) = Тип("Строка") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(ТекущиеСкриншоты);
		ТекущиеСкриншоты = ВременныйМассив;
	КонецЕсли;
	
	ТекущиеВложения = Элемент["attachments"];
	Если ТекущиеВложения = Неопределено Тогда
		ТекущиеВложения = Новый Массив;
	ИначеЕсли ТипЗнч(ТекущиеВложения) = Тип("Строка") Тогда
		ВременныйМассив = Новый Массив;
		ВременныйМассив.Добавить(ТекущиеВложения);
		ТекущиеВложения = ВременныйМассив;
	КонецЕсли;
	
	// Получаем информацию о существующих файлах, чтобы проверить их хэши и имена
	СуществующиеФайлы = Новый Соответствие;
	
	Для Каждого ИдФайла Из ТекущиеСкриншоты Цикл
		Если ТипЗнч(ИдФайла) = Тип("Соответствие") Тогда
			Если ЗначениеЗаполнено(ИдФайла["hash"]) И ЗначениеЗаполнено(ИдФайла["name"]) Тогда
				КлючФайла = Строка(ИдФайла["hash"]) + "_" + Строка(ИдФайла["name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		Иначе
			Инфо = ПолучитьИнформациюОФайле(ИдФайла);
			Если Инфо <> Неопределено И ЗначениеЗаполнено(Инфо["hash"]) И ЗначениеЗаполнено(Инфо["__name"]) Тогда
				КлючФайла = Строка(Инфо["hash"]) + "_" + Строка(Инфо["__name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИдФайла Из ТекущиеВложения Цикл
		Если ТипЗнч(ИдФайла) = Тип("Соответствие") Тогда
			Если ЗначениеЗаполнено(ИдФайла["hash"]) И ЗначениеЗаполнено(ИдФайла["name"]) Тогда
				КлючФайла = Строка(ИдФайла["hash"]) + "_" + Строка(ИдФайла["name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		Иначе
			Инфо = ПолучитьИнформациюОФайле(ИдФайла);
			Если Инфо <> Неопределено И ЗначениеЗаполнено(Инфо["hash"]) И ЗначениеЗаполнено(Инфо["__name"]) Тогда
				КлючФайла = Строка(Инфо["hash"]) + "_" + Строка(Инфо["__name"]);
				СуществующиеФайлы.Вставить(КлючФайла, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	НовыеСкриншоты = Новый Массив;
	Для Каждого СущСкриншот Из ТекущиеСкриншоты Цикл
		НовыеСкриншоты.Добавить(СущСкриншот);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДанныеОтчетаОбОшибке.Скриншот) Тогда
		ХэшСкриншота = ЗагрузитьФайлВElma365(ДанныеОтчетаОбОшибке.Скриншот);
		Если ЗначениеЗаполнено(ХэшСкриншота) Тогда
			ФайлСкриншот = Новый Файл(ДанныеОтчетаОбОшибке.Скриншот);
			КлючФайла = Строка(ХэшСкриншота) + "_" + Строка(ФайлСкриншот.Имя);
			
			Если СуществующиеФайлы.Получить(КлючФайла) = Неопределено Тогда
				ВложениеСкриншот = Новый Соответствие;
				ВложениеСкриншот.Вставить("hash", ХэшСкриншота);
				ВложениеСкриншот.Вставить("name", ФайлСкриншот.Имя);
				НовыеСкриншоты.Добавить(ВложениеСкриншот);
				НужноОбновлять = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НужноОбновлять Тогда
		КонтекстОбновления.Вставить("screenshots", НовыеСкриншоты);
	КонецЕсли;
	
	// --- Обработка остальных файлов ---
	НовыеВложения = Новый Массив;
	Для Каждого СущВложение Из ТекущиеВложения Цикл
		НовыеВложения.Добавить(СущВложение);
	КонецЦикла;
	
	ФайлыОбновлены = Ложь;
	Если ДанныеОтчетаОбОшибке.Файлы <> Неопределено И ДанныеОтчетаОбОшибке.Файлы.Количество() > 0 Тогда
		Для Каждого ПутьКФайлу Из ДанныеОтчетаОбОшибке.Файлы Цикл
			ХэшФайла = ЗагрузитьФайлВElma365(ПутьКФайлу);
			Если ЗначениеЗаполнено(ХэшФайла) Тогда
				ФайлВложение = Новый Файл(ПутьКФайлу);
				КлючФайла = Строка(ХэшФайла) + "_" + Строка(ФайлВложение.Имя);
				
				Если СуществующиеФайлы.Получить(КлючФайла) = Неопределено Тогда
					Вложение = Новый Соответствие;
					Вложение.Вставить("hash", ХэшФайла);
					Вложение.Вставить("name", ФайлВложение.Имя);
					НовыеВложения.Добавить(Вложение);
					ФайлыОбновлены = Истина;
					НужноОбновлять = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ФайлыОбновлены Тогда
		КонтекстОбновления.Вставить("attachments", НовыеВложения);
	КонецЕсли;
	
	// --- Отправка запроса ---
	Если НужноОбновлять Тогда
		Эндпоинт = СтрШаблон("%1/pub/v1/app/%2/%3/%4/update", URL, Раздел, Приложение, ИдЭлемента);
		
		ТелоЗапросаJSON = Новый Соответствие;
		ТелоЗапросаJSON.Вставить("context", КонтекстОбновления);
		
		ПарсерJSON = Новый ПарсерJSON;
		ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("Content-Type", "application/json");
		
		ДопПараметры = Новый Структура("Заголовки", Заголовки);
		РезультатЗапроса = КоннекторHTTP.Post(Эндпоинт, ТелоЗапроса, Неопределено, ДопПараметры);
		
		Если РезультатЗапроса.КодСостояния <> 200 И РезультатЗапроса.КодСостояния <> 204 Тогда
			ТелоОтвета = РезультатЗапроса.Текст();
			Сообщить(СтрШаблон("Не удалось обновить вложения в Elma365. Код ответа: %1. Ответ: %2", РезультатЗапроса.КодСостояния, ТелоОтвета));
		Иначе
			Сообщить(СтрШаблон("Вложения для ошибки %1 успешно обновлены.", ИдЭлемента));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ИзвлечьДанныеИсключения(Отчет)
	МассивОшибок = Отчет["errorInfo"]["applicationErrorInfo"]["errors"];
	Ошибка = МассивОшибок[0];
	Для Каждого ТекОшибка Из МассивОшибок Цикл
		Если ЗначениеЗаполнено(ТекОшибка[0]) Тогда
			Ошибка = ТекОшибка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТекстОшибки = Ошибка[0];
	ТипыОшибки = Ошибка[1];
	
	ЧастиПредставленияОшибки = СтрРазделить(ТекстОшибки, ":");
	МодульОшибки = ЧастиПредставленияОшибки[0];
	МодульОшибки = СтрЗаменить(МодульОшибки, "{", "");
	МодульОшибки = СтрЗаменить(МодульОшибки, "}", "");
	
	Если ЧастиПредставленияОшибки.Количество() > 1 Тогда
		ПредставлениеОшибки = СокрЛП(ЧастиПредставленияОшибки[1]);
	Иначе
		ПредставлениеОшибки = СокрЛП(ТекстОшибки);
	КонецЕсли;
	
	ДанныеИсключения = Новый Структура();
	
	ТипОшибки = "";
	Если ТипыОшибки.Количество() Тогда
		ТипОшибки = ТипыОшибки[0];
	КонецЕсли;
	
	ДанныеИсключения.Вставить("type", ТипОшибки);
	ДанныеИсключения.Вставить("value", ПредставлениеОшибки);
	ДанныеИсключения.Вставить("module", МодульОшибки);
	ДанныеИсключения.Вставить("stack", Отчет["errorInfo"]["applicationErrorInfo"]["stack"]);
	
	Возврат ДанныеИсключения;
КонецФункции

Функция ФорматироватьСтек(Стек)
	Если Стек = Неопределено ИЛИ ТипЗнч(Стек) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	Для Каждого ЭлементСтека Из Стек Цикл
		Если ТипЗнч(ЭлементСтека) = Тип("Массив") И ЭлементСтека.Количество() >= 2 Тогда
			ИмяФайла = ЭлементСтека[0];
			НомерСтроки = ЭлементСтека[1];
			Результат = Результат + СтрШаблон("%1:%2", ИмяФайла, НомерСтроки) + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
