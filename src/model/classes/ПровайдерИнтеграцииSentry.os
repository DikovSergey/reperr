#Использовать 1connector

// DSN
Перем DSN;

// КлючAPI
Перем КлючAPI;

// Логгер
Перем Логгер;

// URL endpoint'а envelope для отправки событий в Sentry
Перем URL;

// true - только заголовок X-Sentry-Auth (для self-hosted Relay: иначе 401 "multiple authorization payloads detected")
Перем АвторизацияТолькоЗаголовок;

// true - заменять значение логгера на additionalInfo из отчета (например, имя базы)
Перем ЗаменятьЛоггерДопИнформацией;

// Инициализирует значения по умолчанию.
Процедура ПриСозданииОбъекта()
	АвторизацияТолькоЗаголовок = Ложь;
	ЗаменятьЛоггерДопИнформацией = Ложь;
КонецПроцедуры


// Отправляет событие в Sentry через endpoint envelope.
//
// Параметры:
//  ДанныеОтчетаОбОшибке - Структура - Данные отчета об ошибке.
//
// Возвращаемое значение:
//  Неопределено
Функция ЗарегистрироватьОшибку(ДанныеОтчетаОбОшибке) Экспорт

	Сообщить("Регистрирую ошибку в Sentry");
	
	Заголовки = Новый Соответствие;
	ЗаголовокАутентификации = СтрШаблон("Sentry sentry_version=7,sentry_key=%1", КлючAPI);
	Заголовки.Вставить("X-Sentry-Auth", ЗаголовокАутентификации);
	
	ИдентификаторСобытия = СтрЗаменить(ДанныеОтчетаОбОшибке.Идентификатор, "-", "");
	Заголовки.Вставить("Content-Type", "application/x-sentry-envelope");
	URLДляЗапроса = ?(АвторизацияТолькоЗаголовок, URL, ДобавитьКлючВURL(URL));
	
	ТелоЗапроса = СериализованноеСобытие(ДанныеОтчетаОбОшибке);
	
	ТелоДляОтправки = УпакованноеВКонвертСобытие(
		ИдентификаторСобытия,
		ТелоЗапроса,
		ДанныеОтчетаОбОшибке.Скриншот,
		ДанныеОтчетаОбОшибке.Файлы);
	
	Если ТелоДляОтправки = Неопределено Тогда
		ВызватьИсключение "Не удалось сформировать envelope для Sentry.";
	КонецЕсли;
	
	РезультатЗапроса = ВыполнитьPOSTЗапросHTTP(URLДляЗапроса, Заголовки, ТелоДляОтправки);
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		
		ТелоОтвета = РезультатЗапроса.ПолучитьТелоКакСтроку();

		Сообщение = СтрШаблон("Не удалось отправить событие в Sentry. Код ответа: %1. URL: %2",
			РезультатЗапроса.КодСостояния,
			URLДляЗапроса);

		Если ЗначениеЗаполнено(ТелоОтвета) Тогда
			Сообщение = Сообщение + Символы.ПС + "Ответ: " + ТелоОтвета;
		КонецЕсли;

		ВызватьИсключение(Сообщение);

	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Устанавливает DSN и рассчитывает URL для отправки в Sentry.
//
// Параметры:
//  вхDSN - Строка - DSN проекта Sentry.
//
// Возвращаемое значение:
//  ЭтотОбъект - ПровайдерИнтеграцииSentry - Для вызовов цепочкой.
Функция DSN(вхDSN) Экспорт
	
	DSN = вхDSN;
	
	УстановитьURLиз(DSN);
	
	Возврат ЭтотОбъект;
	
КонецФункции

// Устанавливает ключ API (sentry_key).
//
// Параметры:
//  вхКлючAPI - Строка - Ключ API.
//
// Возвращаемое значение:
//  ЭтотОбъект - ПровайдерИнтеграцииSentry - Для вызовов цепочкой.
Функция КлючAPI(вхКлючAPI) Экспорт
	Если ЗначениеЗаполнено(вхКлючAPI) Тогда
		КлючAPI = вхКлючAPI;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает режим аутентификации: использовать только заголовок X-Sentry-Auth.
//
// Параметры:
//  вхЗначение - Булево - Истина: не добавлять sentry_key в URL.
//
// Возвращаемое значение:
//  ЭтотОбъект - ПровайдерИнтеграцииSentry - Для вызовов цепочкой.
Функция АвторизацияТолькоЗаголовок(вхЗначение) Экспорт
	АвторизацияТолькоЗаголовок = (вхЗначение = Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Устанавливает имя логгера для события Sentry.
//
// Параметры:
//  вхЛоггер - Строка - Имя логгера.
//
// Возвращаемое значение:
//  ЭтотОбъект - ПровайдерИнтеграцииSentry - Для вызовов цепочкой.
Функция Логгер(вхЛоггер) Экспорт
	
	Логгер = вхЛоггер;
	
	Возврат ЭтотОбъект;
	
КонецФункции

// Устанавливает признак замены логгера доп. информацией
//
// Параметры:
//  вхЗначение - Булево - Истина, если нужно заменять логгер.
//
// Возвращаемое значение:
//  ЭтотОбъект - ПровайдерИнтеграцииSentry - Для вызовов цепочкой.
Функция ЗаменятьЛоггерДопИнформацией(вхЗначение) Экспорт
	ЗаменятьЛоггерДопИнформацией = (вхЗначение = Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Рассчитывает URL endpoint'а envelope из DSN.
//
// Параметры:
//  DSN - Строка - DSN проекта Sentry.
Процедура УстановитьURLиз(Знач DSN)
	НачалоПротокола = СтрНайти(DSN, "://");
	ПозицияСобаки = СтрНайти(DSN, "@", , НачалоПротокола);
	Если НЕ ЗначениеЗаполнено(КлючAPI) И НачалоПротокола > 0 И ПозицияСобаки > НачалоПротокола Тогда
		КлючAPI = Сред(DSN, НачалоПротокола + 3, ПозицияСобаки - НачалоПротокола - 3);
	КонецЕсли;
	Если ПозицияСобаки = 0 Тогда
		Возврат;
	КонецЕсли;
	ЧастьДоСобаки = Лев(DSN, НачалоПротокола + 2);
	ЧастьПослеСобаки = Сред(DSN, ПозицияСобаки + 1);
	ПоследнийСлэш = СтрНайти(ЧастьПослеСобаки, "/", НаправлениеПоиска.СКонца);
	ХостИПорт = Лев(ЧастьПослеСобаки, ПоследнийСлэш - 1);
	ИдПроекта = Прав(ЧастьПослеСобаки, СтрДлина(ЧастьПослеСобаки) - ПоследнийСлэш);
	URL = СтрШаблон("%1%2/api/%3/envelope/", ЧастьДоСобаки, ХостИПорт, ИдПроекта);
КонецПроцедуры

// Добавляет sentry_key и sentry_version в URL.
//
// Параметры:
//  АдресURL - Строка - URL, к которому нужно добавить параметры.
//
// Возвращаемое значение:
//  Строка - URL с параметрами sentry_key/sentry_version.
Функция ДобавитьКлючВURL(Знач АдресURL)
	Если СтрНайти(АдресURL, "?") > 0 Тогда
		Возврат СтрШаблон("%1&sentry_key=%2&sentry_version=7", АдресURL, КлючAPI);
	Иначе
		Возврат СтрШаблон("%1?sentry_key=%2&sentry_version=7", АдресURL, КлючAPI);
	КонецЕсли;
КонецФункции

#Область Envelope

// Упаковывает событие в envelope (конверт) с опциональными вложениями: скриншот (если передан) и доп. вложения.
//
// Параметры:
//  ИдентификаторСобытия - Строка - EventId без разделителей.
//  ТелоЗапроса - Строка - JSON события Sentry.
//  ПутьКСкриншоту - Строка - Полный путь к файлу скриншота (может быть пустым).
//  ПутиКДопВложениям - Массив из Строка - Полные пути к файлам доп. вложений (может быть Неопределено или пустым).
//
// Возвращаемое значение:
//  ДвоичныеДанные - Envelope (конверт) с событием и вложениями.
//  Или Неопределено - При ошибке формирования.
Функция УпакованноеВКонвертСобытие(ИдентификаторСобытия, ТелоЗапроса, ПутьКСкриншоту = "", ПутиКДопВложениям = Неопределено)
	
	ДанныеСобытия = ПолучитьДвоичныеДанныеИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, Ложь);

	ЗаголовокКонверта = СтрШаблон("{""event_id"":""%1""}", ИдентификаторСобытия);
	РазмерСобытия = ДанныеСобытия.Размер();
	ЗаголовокСобытия = СтрШаблон(
		"{""type"":""event"",""length"":%1,""content_type"":""application/json""}",
		РазмерСобытия);
	
	СписокВложений = Новый Массив;
	Если ЗначениеЗаполнено(ПутьКСкриншоту) Тогда
		ФайлСкрин = Новый Файл(ПутьКСкриншоту);
		Если ФайлСкрин.Существует() Тогда
			Вложение = Новый Структура;
			Вложение.Вставить("Путь", ПутьКСкриншоту);
			Вложение.Вставить("ИмяФайла", "screenshot.png");
			Вложение.Вставить("ТипКонтента", "image/png");
			СписокВложений.Добавить(Вложение);
		КонецЕсли;
	КонецЕсли;
	Если ПутиКДопВложениям <> Неопределено Тогда
		Для Каждого ПутьКФайлу Из ПутиКДопВложениям Цикл
			Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
				Продолжить;
			КонецЕсли;
			ФайлВлож = Новый Файл(ПутьКФайлу);
			Если ФайлВлож.Существует() Тогда
				ИмяФайла = ФайлВлож.Имя;
				ТипКонтента = ТипКонтентаПоРасширению(ИмяФайла);
				СписокВложений.Добавить(Новый Структура("Путь, ИмяФайла, ТипКонтента", ПутьКФайлу, ИмяФайла, ТипКонтента));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Поток = Новый ПотокВПамяти();
	Запись = Новый ЗаписьДанных(Поток);

	ПС = Символ(10);
	ДобавитьСтрокуКакДвоичныеДанные(Запись, ЗаголовокКонверта + ПС);
	ДобавитьСтрокуКакДвоичныеДанные(Запись, ЗаголовокСобытия + ПС);
	Запись.Записать(ДанныеСобытия);
	ДобавитьСтрокуКакДвоичныеДанные(Запись, ПС);
	Для Каждого Вложение Из СписокВложений Цикл
		ДвоичныеВложения = Новый ДвоичныеДанные(Вложение.Путь);
		РазмерВложения = ДвоичныеВложения.Размер();
		ИмяЭкранир = СтрЗаменить(Вложение.ИмяФайла, "\", "\\");
		ИмяЭкранир = СтрЗаменить(ИмяЭкранир, """", "\""");
		ЗаголовокВложения = СтрШаблон(
			"{""type"":""attachment"",""length"":%1,""filename"":""%2"",""content_type"":""%3""}",
			РазмерВложения,
			ИмяЭкранир,
			Вложение.ТипКонтента);
		ДобавитьСтрокуКакДвоичныеДанные(Запись, ЗаголовокВложения + ПС);
		Запись.Записать(ДвоичныеВложения);
		ДобавитьСтрокуКакДвоичныеДанные(Запись, ПС);
	КонецЦикла;

	Результат = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	Запись.Закрыть();

	Возврат Результат;

КонецФункции

// Возвращает MIME-тип по расширению файла.
//
// Параметры:
//  ИмяФайла - Строка - Имя файла (с расширением).
//
// Возвращаемое значение:
//  Строка - MIME-тип.
Функция ТипКонтентаПоРасширению(ИмяФайла)
	
	Расширение = "";
	ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки > 0 Тогда
		Расширение = НРег(Сред(ИмяФайла, ПозицияТочки + 1));
	КонецЕсли;
	
	СоответствиеТипов = Новый Соответствие;
	СоответствиеТипов.Вставить("png", "image/png");
	СоответствиеТипов.Вставить("jpg", "image/jpeg");
	СоответствиеТипов.Вставить("jpeg", "image/jpeg");
	СоответствиеТипов.Вставить("gif", "image/gif");
	СоответствиеТипов.Вставить("webp", "image/webp");
	СоответствиеТипов.Вставить("json", "application/json");
	СоответствиеТипов.Вставить("txt", "text/plain");
	СоответствиеТипов.Вставить("html", "text/html");
	СоответствиеТипов.Вставить("xml", "application/xml");
	Если СоответствиеТипов.Получить(Расширение) <> Неопределено Тогда
		Возврат СоответствиеТипов[Расширение];
	КонецЕсли;
	
	Возврат "application/octet-stream";
	
КонецФункции

// Записывает строку в поток как набор ASCII-байт.
//
// Параметры:
//  Запись - ЗаписьДанных - Запись в поток.
//  Строка - Строка - Строка для записи.
Процедура ДобавитьСтрокуКакДвоичныеДанные(Запись, Строка)
	ДД = ПолучитьДвоичныеДанныеИзСтроки(Строка, КодировкаТекста.UTF8, Ложь);
	Запись.Записать(ДД);
КонецПроцедуры

#КонецОбласти

Функция ВыполнитьPOSTЗапросHTTP(Знач URLДляЗапроса, Заголовки, ТелоДляОтправки)
	
	ЭтоHTTPS = Лев(НРег(URLДляЗапроса), 8) = "https://";
	ДлинаСхемы = ?(ЭтоHTTPS, 8, 7);
	БезСхемы = Сред(URLДляЗапроса, ДлинаСхемы + 1);
	
	ПозицияСлэша = СтрНайти(БезСхемы, "/");
	ХостСПортом = ?(ПозицияСлэша > 0, Лев(БезСхемы, ПозицияСлэша - 1), БезСхемы);
	Путь = ?(ПозицияСлэша > 0, Сред(БезСхемы, ПозицияСлэша), "/");
	
	ПозицияДвоеточия = СтрНайти(ХостСПортом, ":", НаправлениеПоиска.СКонца);
	Хост = ХостСПортом;
	Порт = ?(ЭтоHTTPS, 443, 80);
	Если ПозицияДвоеточия > 0 Тогда
		Хост = Лев(ХостСПортом, ПозицияДвоеточия - 1);
		ПортСтрокой = Сред(ХостСПортом, ПозицияДвоеточия + 1);
		Если ЗначениеЗаполнено(ПортСтрокой) Тогда
			Порт = Число(ПортСтрокой);
		КонецЕсли;
	КонецЕсли;
	
	АдресСервера = ?(ЭтоHTTPS, "https://" + Хост, Хост);
	Соединение = Новый HTTPСоединение(АдресСервера, Порт, , , , 30);
	
	Запрос = Новый HTTPЗапрос(Путь);
	Для Каждого Заголовок Из Заголовки Цикл
		Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
	КонецЦикла;
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДляОтправки);
	
	Попытка
		Возврат Соединение.ВызватьHTTPМетод("POST", Запрос);
	Исключение
		ВызватьИсключение СтрШаблон("Ошибка при выполнении POST-запроса к %1: %2", URLДляЗапроса, ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

// Формирует Sentry Event и сериализует его в JSON.
//
// Параметры:
//  ДанныеОтчетаОбОшибке - Структура - Данные отчета об ошибке.
//
// Возвращаемое значение:
//  Строка - JSON события Sentry.
Функция СериализованноеСобытие(ДанныеОтчетаОбОшибке) Экспорт
	
	Отчет = ДанныеОтчетаОбОшибке.Отчет;
	ДанныеИсключения = ИзвлечьДанныеИсключения(Отчет);
	
	ТелоЗапросаJSON = Новый Соответствие();
	
	ТелоЗапросаJSON.Вставить("event_id", СтрЗаменить(ДанныеОтчетаОбОшибке.Идентификатор, "-", ""));
	ТелоЗапросаJSON.Вставить("timestamp", Отчет["time"]);
	ТелоЗапросаJSON.Вставить("level", "error");
	ДопИнфо = Отчет["additionalInfo"];
	Если ЗаменятьЛоггерДопИнформацией И ЗначениеЗаполнено(ДопИнфо) Тогда
		ТелоЗапросаJSON.Вставить("logger", ДопИнфо);
	Иначе
		ТелоЗапросаJSON.Вставить("logger", Логгер);
	КонецЕсли;
	ТелоЗапросаJSON.Вставить("platform", "Other");
	
	ДопИнфо = Отчет["additionalInfo"];
	Если ЗначениеЗаполнено(ДопИнфо) Тогда
		ТелоЗапросаJSON.Вставить("environment", ДопИнфо);
	КонецЕсли;
	
	ТелоЗапросаJSON.Вставить("transaction", ДанныеИсключения["module"]);
	ТелоЗапросаJSON.Вставить("release", Отчет["configInfo"]["hash"]);
	
	ИмяПользователя = "";
	Если Отчет["sessionInfo"] <> Неопределено Тогда
		ИмяПользователя = Отчет["sessionInfo"]["userName"];
	КонецЕсли;
	
	Пользователь = Новый Соответствие;
	Пользователь.Вставить("username", ИмяПользователя);
	ТелоЗапросаJSON.Вставить("user", Пользователь);
	
	ТелоЗапросаJSON.Вставить("tags", Метки(Отчет));
	ТелоЗапросаJSON.Вставить("exception", СформироватьИсключение(ДанныеИсключения));
	ТелоЗапросаJSON.Вставить("modules", Расширения(Отчет));
	ТелоЗапросаJSON.Вставить("extra", ДополнительнаяИнформация(Отчет));
	ОписаниеПользователя = Неопределено;
	Если Отчет["errorInfo"] <> Неопределено Тогда
		ОписаниеПользователя = Отчет["errorInfo"]["userDescription"];
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеПользователя) Тогда
		ТелоЗапросаJSON.Вставить("message", ОписаниеПользователя);
		Сообщить(СтрШаблон("Sentry: пользовательское описание отправлено: ""%1""", ОписаниеПользователя));
	КонецЕсли;
	ТелоЗапросаJSON.Вставить("fingerprint", Отпечаток(ТелоЗапросаJSON, ДанныеИсключения));
	
	ПарсерJSON = Новый ПарсерJSON();
	ТелоЗапроса = ПарсерJSON.ЗаписатьJSON(ТелоЗапросаJSON);
	
	Возврат ТелоЗапроса;
	
КонецФункции

// Извлекает из отчета данные исключения, пригодные для Sentry Event.
//
// Параметры:
//  Отчет - Соответствие - Десериализованный JSON отчета.
//
// Возвращаемое значение:
//  Структура - Поля: type, value, module.
Функция ИзвлечьДанныеИсключения(Отчет)
	
	МассивОшибок = Отчет["errorInfo"]["applicationErrorInfo"]["errors"];
	Ошибка = МассивОшибок[0];
	Для Каждого ТекОшибка Из МассивОшибок Цикл
		Если ЗначениеЗаполнено(ТекОшибка[0]) Тогда
			Ошибка = ТекОшибка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТекстОшибки = Ошибка[0];
	ТипыОшибки = Ошибка[1];
	
	ЧастиПредставленияОшибки = СтрРазделить(ТекстОшибки, ":");
	МодульОшибки = ЧастиПредставленияОшибки[0];
	МодульОшибки = СтрЗаменить(МодульОшибки, "{", "");
	МодульОшибки = СтрЗаменить(МодульОшибки, "}", "");

	Если ЧастиПредставленияОшибки.Количество() > 1 Тогда
		ПредставлениеОшибки = СокрЛП(ЧастиПредставленияОшибки[1]);
	Иначе
		ПредставлениеОшибки = СокрЛП(ТекстОшибки);
	КонецЕсли;
	
	ДанныеИсключения = Новый Структура();
	
	// Обрабатывается пока только первый тип, но их может быть несколько.
	ТипОшибки = "";
	Если ТипыОшибки.Количество() Тогда
		ТипОшибки = ТипыОшибки[0];
	КонецЕсли;
	
	ДанныеИсключения.Вставить("type", ТипОшибки);
	ДанныеИсключения.Вставить("value", ПредставлениеОшибки);
	ДанныеИсключения.Вставить("module", МодульОшибки);
	
	Стек = Отчет["errorInfo"]["applicationErrorInfo"]["stack"];
	ДанныеИсключения.Вставить("stack", Стек);
	
	Возврат ДанныеИсключения;
	
КонецФункции

Функция Метки(Отчет)
	
	Метки = Новый Соответствие();
	Метки.Вставить("1C-version", Отчет["serverInfo"]["appVersion"]);
	
	ВерсияКонфигурации = Отчет["configInfo"]["version"];
	Если ЗначениеЗаполнено(ВерсияКонфигурации) Тогда
		Метки.Вставить("conf-version", ВерсияКонфигурации);
	КонецЕсли;
	
	ДополнительнаяИнформация = Отчет["additionalInfo"];
	Если ЗначениеЗаполнено(ДополнительнаяИнформация) Тогда
		Метки.Вставить("additionalInfo", ДополнительнаяИнформация);
	КонецЕсли;
	
	Возврат Метки;
	
КонецФункции

Функция СформироватьИсключение(ДанныеИсключения)
	
	ЗначениеИсключения = Новый Соответствие();
	ЗначениеИсключения.Вставить("type", ДанныеИсключения["type"]);
	ЗначениеИсключения.Вставить("value", ДанныеИсключения["value"]);
	ЗначениеИсключения.Вставить("module", ДанныеИсключения["module"]);
	Механизм = Новый Соответствие();
	Механизм.Вставить("handled", Ложь);
	ЗначениеИсключения.Вставить("mechanism", Механизм);
	
	Стек = ДанныеИсключения["stack"];
	Если Стек <> Неопределено И ТипЗнч(Стек) = Тип("Массив") Тогда
		Фреймы = Новый Массив;
		
		// Sentry ожидает стек в обратном порядке (от старых вызовов к новым)
		Индекс = Стек.Количество() - 1;
		Пока Индекс >= 0 Цикл
			ЭлементСтека = Стек[Индекс];
			Если ТипЗнч(ЭлементСтека) = Тип("Массив") И ЭлементСтека.Количество() >= 2 Тогда
				Фрейм = Новый Соответствие;
				Фрейм.Вставить("filename", ЭлементСтека[0]);
				Фрейм.Вставить("lineno", ЭлементСтека[1]);
				Если ЭлементСтека.Количество() >= 3 Тогда
					Фрейм.Вставить("context_line", СокрЛП(ЭлементСтека[2]));
				КонецЕсли;
				Фреймы.Добавить(Фрейм);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		
		Если Фреймы.Количество() > 0 Тогда
			СтекТрейс = Новый Соответствие;
			СтекТрейс.Вставить("frames", Фреймы);
			ЗначениеИсключения.Вставить("stacktrace", СтекТрейс);
		КонецЕсли;
	КонецЕсли;
	
	Исключения = Новый Массив;
	Исключения.Добавить(ЗначениеИсключения);
	
	Результат = Новый Соответствие();
	Результат.Вставить("values", Исключения);
	
	Возврат Результат;
	
КонецФункции

Функция Расширения(Отчет)
	
	Результат = Новый Соответствие();
	
	БлокРасширения = Отчет["configInfo"]["extentions"];
	Если БлокРасширения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Расширение Из БлокРасширения Цикл
		Результат.Вставить(Расширение[0], Расширение[1]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДополнительнаяИнформация(Отчет)
	
	Результат = Новый Соответствие();
	Результат.Вставить("compatibilityMode", Отчет["configInfo"]["compatibilityMode"]);
	
	Возврат Результат;
	
КонецФункции

Функция Отпечаток(ТелоЗапросаJSON, ДанныеИсключения)
	
	Результат = Новый Массив;
	Результат.Добавить(ТелоЗапросаJSON["release"]);
	Результат.Добавить(ДанныеИсключения["module"]);
	Результат.Добавить(ДанныеИсключения["value"]);
	
	Если ЗаменятьЛоггерДопИнформацией Тогда
		Результат.Добавить(ТелоЗапросаJSON["logger"]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции