{
    "Logging":{
        "Console":{
            "LogLevel":{
                "OneScript.WebHost.Application.ApplicationInstance":"Debug",
                "Default":"Information"
            }
        }
    },
    "urls": "http://localhost:5000",
    "reperrSettings":{
        "DataStorage":{
            "file": {
                "enabled": true,
                "path": "data"
            }
        },
        "Integrations":{
            "redmine": {
                "enabled": false,
                "url": "http://example.redmine.org",
                "APIKey": "example",
                "project-id": "example",
                "tracker-id": "0",
                "priority-id": "4",
                "status-id": "0",
                "hours": "1",
                "topic": "Автоматически зарегистрированная ошибка" 
            },
            "jira": {
                "enabled": false,
                "url": "https://example.atlassian.net/rest/api/latest",
                "login": "example@mail.com",
                "token": "example",
                "project-key": "REP",
                "issuetype-id": "10000",
                "priority-id": "4",
                "status-id": "0",
                "summary": "Автоматически зарегистрированная ошибка" 
            },
            "rabbitMQ": {
                "enabled": false,
                "user": "example",
                "password": "example",
                "server": "example.rmq.cloudamqp.com",
                "vhost": "/",
                "exchange": "example"
            },
			"sentry": {
                "enabled": false,
                "dsn": "https://key@server.ingest.sentry.io/project_id",
                "logger": "logger.reperr.errors",
                "authHeaderOnly": true,
                "replaceLoggerWithAdditionalInfo": true
            },
            "elma365": {
                "enabled": false,
                "url": "https://elma365.example.com",
                "token": "token",
                "namespace": "it_support",
                "app": "request",
                "identifier-field": "error_hash",
                "user-name-field": "error_user_name",
                "user-reference-field": "affected_users",
                "support-get-existing-error": true,
                "start-process": {
                    "enabled": false,
                    "namespace": "it_support.request",
                    "code": "request",
                    "item-context-variable": ""
                },
                "user-email-api": {
                    "enabled": true,
                    "method": "GET",
                    "user-name-parameter": "UserName",
                    "url": "https://example.com/api/user-email",
                    "user": "user_name",
                    "password": "password"
                },
                "field-mapping": {
                    "description": "{UserDescription}",
                    "error_1c_base": "{AdditionalInfo}",
                    "error_text": "{ErrorText}",
                    "stack_trace": "{StackTrace}",
                    "app_version": "{AppVersion}",
                    "user": "{User}",
                    "request_type_app": ["019dbe0c-e621-74aa-b637-945023c7a137"],
                    "Category": [
                        {
                            "code": "software"
                        }
                    ],
                    "type_software": [
                        {
                            "code": "1c_errors"
                        }
                    ]
                }
            }
        }
    }
}