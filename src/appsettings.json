{
    "Logging":{
        "Console":{
            "LogLevel":{
                "OneScript.WebHost.Application.ApplicationInstance":"Debug",
                "Default":"Information"
            }
        }
    },
    "urls": "http://localhost:5000",
    "reperrSettings":{
        "DataStorage":{
            "file": {
                "enabled": true,
                "path": "data"
            }
        },
        "Integrations":{
            "redmine": {
                "enabled": false,
                "url": "http://example.redmine.org",
                "APIKey": "example",
                "project-id": "example",
                "tracker-id": "0",
                "priority-id": "4",
                "status-id": "0",
                "hours": "1",
                "topic": "Автоматически зарегистрированная ошибка" 
            },
            "jira": {
                "enabled": false,
                "url": "https://example.atlassian.net/rest/api/latest",
                "login": "example@mail.com",
                "token": "example",
                "project-key": "REP",
                "issuetype-id": "10000",
                "priority-id": "4",
                "status-id": "0",
                "summary": "Автоматически зарегистрированная ошибка" 
            },
            "rabbitMQ": {
                "enabled": false,
                "user": "example",
                "password": "example",
                "server": "example.rmq.cloudamqp.com",
                "vhost": "/",
                "exchange": "example"
            },
			"sentry": {
                "enabled": false,
                "dsn": "https://key@server.ingest.sentry.io/project_id",
                "logger": "logger.reperr.errors",
                "authHeaderOnly": true,
                "replaceLoggerWithAdditionalInfo": true
            },
            "elma365": {
                "enabled": false,
                "url": "https://telma.tcn-nn.ru",
                "token": "de2e2173-d51d-4be8-80ed-608561d3e04c",
                "namespace": "it_support",
                "app": "request",
                "identifierField": "error_hash",
                "userNameField": "error_user_name",
                "supportGetExistingError": true,
                "fieldMapping": {
                    "description": "{UserDescription}",
                    "error_1c_base": "{AdditionalInfo}",
                    "error_text": "{ErrorText}",
                    "stack_trace": "{StackTrace}",
                    "app_version": "{AppVersion}",
                    "user": "{User}",
                    "Category": [
                        {
                            "code": "software"
                        }
                    ],
                    "type_software": [
                        {
                            "code": "1c_errors"
                        }
                    ]
                }
            }
        }
    }
}